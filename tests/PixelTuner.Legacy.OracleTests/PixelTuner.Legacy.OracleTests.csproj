<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs PixelTuner 2's own export code (compiled from legacy/) next to the port and
       compares the bytes. Only code that needs no Windows API beyond images is compiled here; the
       System.Drawing.Bitmap and WPF GIF decoder uses are served by small stand-ins. -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0414;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PixelTuner.Core\PixelTuner.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\legacy\PixelTuner2\Communication\ColorDepth.cs" Link="Legacy\ColorDepth.cs" />
    <Compile Include="..\..\legacy\PixelTuner2\Communication\Binarize\*.cs" LinkBase="Legacy\Binarize" />
    <Compile Include="..\..\legacy\PixelTuner2\Communication\Gradient\*.cs" LinkBase="Legacy\Gradient" />
    <!-- Pixel, fan and video export. The fan item class is left out: GetFanBinaryPresentation
         never used it, and it saved a debug bitmap to c:\test.bmp. -->
    <!-- The mesh warp of the import window's Transform page. -->
    <Compile Include="..\..\legacy\PixelTuner2\Common\Imaging\WarpGrid.cs" Link="Legacy\WarpGrid.cs" />
    <!-- The LED markup of the canvas element window: pure chain logic, no WPF. -->
    <Compile Include="..\..\legacy\PixelTuner2\PixelTuner\ViewModel\Tools\LedMarkup.cs" Link="Legacy\LedMarkup.cs" />
    <Compile Include="..\..\legacy\PixelTuner2\Communication\Pixelate\*.cs" Exclude="..\..\legacy\PixelTuner2\Communication\Pixelate\ImagesCollectionFanItem.cs" LinkBase="Legacy\Pixelate" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>
</Project>
