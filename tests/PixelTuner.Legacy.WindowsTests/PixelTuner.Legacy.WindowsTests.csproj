<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the new code against the Windows decoders PixelTuner 2 used (WPF, GDI+).
       Windows only, so it is not in the solution; CI runs it on the Windows runner. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PixelTuner.Core\PixelTuner.Core.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>
</Project>
