<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\PixelTuner.Package\PixelTuner.Package.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native Skia for the OS the tests run on (the export decodes images). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>
  <ItemGroup>
    <!-- The real PixelTuner 2 shows of the Core tests. -->
    <None Include="..\PixelTuner.Core.Tests\Fixtures\LegacyProjects\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures\LegacyProjects" />
  </ItemGroup>
</Project>
