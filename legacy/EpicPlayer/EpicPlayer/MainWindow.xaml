<Window x:Class="SongReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-pic player" Background="#ff202020" Height="280" Width="600" Icon="icon.ico">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical">
            <Button x:Name="FileUpload" Content="Load File" Height="32" Margin="8,8,8,2" Click="loadFile" />
            <TextBox x:Name="boxMulticastAddress" ToolTip="Multicast Address" Margin="8,4" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Height="22"/>
            <Label x:Name="songTitle" Content="" Foreground="White" Margin="8"/>
            <ProgressBar x:Name="songProgress" BorderThickness="0" Height="24" MinWidth="560" Margin="8,4" Background="#1aFFFFFF" Foreground="#FF29EE4D"/>
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="songStartTime" Content="" Grid.Column="0" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Label x:Name="songEndTime" Content="" Grid.Column="1" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"/>
            </Grid>
        </StackPanel>
        <StackPanel x:Name="playbackPanel" Grid.Column="1" Orientation="Vertical" >
            <Button x:Name="playButton" Content="Play" Margin="8,8,8,4" Height="42" Click="Play"/>
            <Button x:Name="PauseButton" Content="Pause" Margin="8,4" Height="42" Click="Pause"/>
            <Button x:Name="stopButton" Content="Stop" Margin="8,4" Height="42" Click="Stop"/>
            <Button x:Name="closeButton" Content="Close" Margin="8,4" Height="42" Click="Close" Visibility="Collapsed"/>
            <Label x:Name="playStatus" Content="Status: Off" Margin="8,4" Foreground="White"/>
            <Slider x:Name="volumeSlider" Maximum="1" TickFrequency="-1" Margin="8,4" ValueChanged="volumeSlider_ValueChanged"/>
            <Label x:Name="volumeLabel" Content="Volume: " Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="234.333,318,0,0" VerticalAlignment="Top" Width="162"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="8">
            <CheckBox x:Name="boxUseArtnet" HorizontalAlignment="Left" Unchecked="boxUseArtnet_Unchecked" Checked="boxUseArtnet_Checked" FlowDirection="RightToLeft">
                <TextBlock Foreground="White" Text="Use Artnet"/>
            </CheckBox>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.68*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <Label Foreground="White" Content="Local IP:" />
                    <Label Foreground="White" Content="Subnet:" />
                    <Label Foreground="White" Content="Local Port:" />
                    <Label Foreground="White" Content="Universe:" />
                    <Label Foreground="White" Content="Channel:" />
                    <Label Foreground="White" Content="Start:" />
                    <Label Foreground="White" Content="Stop:" />
                    <Label Foreground="White" Content="Pause:" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBox x:Name="boxArtnetIP" Text="192.168.88.253" Margin="4,4" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="boxArtnetMask" Text="255.255.255.0" Margin="4,4" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="boxArtnetPort" Text="3333" Margin="4,4" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="boxArtnetUni" Text="1" Margin="4,4" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="boxArtnetChannel" Text="1" Margin="4,4" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="boxArtnetStart" Text="50" Margin="4,4" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="boxArtnetStop" Text="100" Margin="4,4" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="boxArtnetPause" Text="150" Margin="4,4" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
