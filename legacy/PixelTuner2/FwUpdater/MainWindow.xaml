<Window x:Class="FwUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FwUpdater"
        mc:Ignorable="d"
        Title="Firmware update" Height="350" Width="525">
    <Grid Background="#FF3A3A3A">
        <DockPanel LastChildFill="True" Margin="4">
            <StackPanel Orientation="Vertical" DockPanel.Dock="Top">
                <TextBlock Text="{Binding DeviceName, StringFormat=Device: {0}}" Foreground="White" Height="20"/>
                <TextBlock Text="{Binding FilePath, StringFormat=File: {0}}" Foreground="White" Height="20"/>
            </StackPanel>
            <Button Name="BoxUpload" AllowDrop="True" Drop="BoxUpload_OnDrop" Content="Upload" Height="Auto" Background="#FF97928B" BorderBrush="{x:Null}" Click="BoxUpload_Click"></Button>
        </DockPanel>
    </Grid>
</Window>
