<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Bundle
      Name="PixelTuner"
      Version="$(var.PackageVersion)"
      IconSourceFile="PixelTuner.ico"
      AboutUrl="http://e-pic.ru/pixel-poi-2/pixel-poi-2-guide/"
      UpdateUrl="http://e-pic.ru/downloads/"
      UpgradeCode="{df1086f7-6803-4697-b66c-74dd2733c092}"
      Compressed="no">
    <BootstrapperApplicationRef Id="ManagedBootstrapperApplicationHost">
      <Payload Name='BootstrapperCore.config' SourceFile='./WixBA/bin/$(var.Configuration)/WixBA.BootstrapperCore.config' />
      <Payload SourceFile='./WixBA/bin/$(var.Configuration)/WixBA.dll' />
      <Payload Compressed="yes" SourceFile="NetfxLicense.rtf"/>
    </BootstrapperApplicationRef>
    <Chain>
      <PackageGroupRef Id="NetFx46Web"/>
      <PackageGroupRef Id="DriverInstaller"/>
      <PackageGroupRef Id="DriverInstaller_x64"/>
      <PackageGroupRef Id="PixelTunerInstaller"/>
      <PackageGroupRef Id="DirectXInstaller"/>
    </Chain>
  </Bundle>
  <Fragment>
    <PackageGroup Id="DriverInstaller">
      <ExePackage
        Id="DriverPackage"
        Cache="no"
        Compressed="yes"
        PerMachine="yes"
        Permanent="yes"
        Vital="yes"
        SourceFile="VCP_V1.3.1_Setup.exe"
        InstallCondition="NOT VersionNT64"/>
    </PackageGroup>
  </Fragment>

  <Fragment>
    <PackageGroup Id="DriverInstaller_x64">
      <ExePackage
        Id="DriverPackage_x64"
        Cache="no"
        Compressed="yes"
        PerMachine="yes"
        Permanent="yes"
        Vital="yes"
        SourceFile="VCP_V1.3.1_Setup_x64.exe"
        InstallCondition="VersionNT64"/>
    </PackageGroup>
  </Fragment>
  
  <Fragment>
    <PackageGroup Id="PixelTunerInstaller">
      <MsiPackage
        Id="PixelTunerPackage"
        Cache="no"
        Compressed="yes"
        Vital="yes"
        SourceFile="$(var.PixelTunerMsiPath)" />
    </PackageGroup>
  </Fragment>

  <Fragment>
    <PackageGroup Id="DirectXInstaller">
      <ExePackage
        Id="DirectXPackage"
        Cache="no"
        Compressed="yes"
        Permanent="yes"
        Vital="yes"
        SourceFile="directx_Jun2010_redist.exe" />
    </PackageGroup>
  </Fragment>
</Wix>
