<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Bundle
      Name="PixelTuner"
      Version="$(var.PackageVersion)"
      IconSourceFile="PixelTuner.ico"
      AboutUrl="http://shiningpromo.ru/pixel_poi/"
      UpdateUrl="http://shiningpromo.ru/pixel_poi/downloads/"
      UpgradeCode="01986B34-AF3E-47CC-A24A-3D3989775451"
      Compressed="no">
    <BootstrapperApplicationRef Id="ManagedBootstrapperApplicationHost">
      <!--<Payload SourceFile="WixUX.dll" />-->
      <Payload Compressed="no" SourceFile="NetfxLicense.rtf"/>
    </BootstrapperApplicationRef>
    <Chain>
      <PackageGroupRef Id="Netfx4WebInstaller"/>
      <PackageGroupRef Id="DriverInstaller"/>
      <PackageGroupRef Id="DriverInstaller_x64"/>
      <PackageGroupRef Id="PixelTunerInstaller"/>
    </Chain>
  </Bundle>
  <Fragment>
    <WixVariable Id="WixMbaPrereqPackageId" Value="Netfx4WebInstaller" />
    <WixVariable Id="WixMbaPrereqLicenseUrl" Value="NetfxLicense.rtf" />
    <util:RegistrySearch
        Variable="Netfx4FullVersion"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Net Framework Setup\NDP\v4\Full"
        Value="Version"
        Win64="no"/>
    <util:RegistrySearch
        Variable="Netfx4x64FullVersion"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Net Framework Setup\NDP\v4\Full"
        Value="Version"
        Win64="yes" />

    <PackageGroup
        Id="Netfx4WebInstaller">
      <ExePackage
          Id="Net4WebPackage"
          Cache="no"
          Compressed="no"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          SourceFile="dotNetFx40_Full_setup.exe"
          DownloadUrl="http://go.microsoft.com/fwlink/?LinkId=164193"
          InstallCondition="NOT (Netfx4FullVersion AND (NOT VersionNT64 OR Netfx4x64FullVersion) AND VersionNT >= v5.1)"/>
    </PackageGroup>
  </Fragment>
  
  <Fragment>
    <PackageGroup Id="DriverInstaller">
      <ExePackage
        Id="DriverPackage"
        Cache="no"
        Compressed="no"
        PerMachine="yes"
        Permanent="yes"
        Vital="yes"
        SourceFile="VCP_V1.3.1_Setup.exe"
        InstallCondition="NOT VersionNT64"/>
    </PackageGroup>
  </Fragment>

  <Fragment>
    <PackageGroup Id="DriverInstaller_x64">
      <ExePackage
        Id="DriverPackage_x64"
        Cache="no"
        Compressed="no"
        PerMachine="yes"
        Permanent="yes"
        Vital="yes"
        SourceFile="VCP_V1.3.1_Setup_x64.exe"
        InstallCondition="VersionNT64"/>
    </PackageGroup>
  </Fragment>
  
  <Fragment>
    <PackageGroup Id="PixelTunerInstaller">
      <MsiPackage
        Id="PixelTunerPackage"
        Cache="no"
        Compressed="no"
        Vital="yes"
        SourceFile="$(var.PixelTunerMsiPath)" />
    </PackageGroup>
  </Fragment>
</Wix>