<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PixelTuner.ViewModel"
                    xmlns:vmd="clr-namespace:PixelTuner.ViewModel.Devices">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="WifiDeviceTemplate" DataType="{x:Type vmd:WifiInfoDevice}">
        <Grid Margin="10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition ColumnDefinition.Width="16" />
                <ColumnDefinition ColumnDefinition.Width="90" />
                <ColumnDefinition ColumnDefinition.Width="*" ColumnDefinition.MinWidth="80" />
                <ColumnDefinition ColumnDefinition.Width="94" />
            </Grid.ColumnDefinitions>
            <ProgressBar ProgressBar.Name="UploadProgressBar" FrameworkElement.Style="{StaticResource OperationProgressBarStyle}" Grid.ColumnSpan="3" UIElement.Opacity="0.25" FrameworkElement.Margin="0,4,4,4" RangeBase.Value="{Binding Progress}" RangeBase.Minimum="{Binding ProgressMin}" RangeBase.Maximum="{Binding ProgressMax}" />
            <TextBlock TextBlock.Text="IP:" TextBlock.Foreground="#FFFFFFFF" Grid.Column="0" FrameworkElement.Margin="2,0,0,0" FrameworkElement.VerticalAlignment="Center" />
            <TextBlock TextBlock.Foreground="#FFFFFFFF" Grid.Column="1" FrameworkElement.VerticalAlignment="Center" TextBlock.Text="{Binding IP}" FrameworkElement.ToolTip="{Binding ChannelID}" />
            <TextBlock TextBlock.Foreground="#FFFFFFFF" Grid.Column="2" FrameworkElement.VerticalAlignment="Center" TextBlock.Text="{Binding Name}" FrameworkElement.ToolTip="{Binding Tag}" />
            <StackPanel StackPanel.Orientation="Horizontal" Grid.Column="4" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Stretch">
                <Button ContentControl.Content="Upload" FrameworkElement.ToolTip="Upload current project.." FrameworkElement.Width="48" FrameworkElement.Margin="1,2" ButtonBase.Command="{Binding UploadCommand}" />
                <Button FrameworkElement.Style="{StaticResource ButtonPlayStyle}" FrameworkElement.Width="12" FrameworkElement.Margin="2" ButtonBase.Command="{Binding PlayCommand}" />
                <Button FrameworkElement.Style="{StaticResource ButtonStopStyle}" FrameworkElement.Width="12" FrameworkElement.Margin="2" ButtonBase.Command="{Binding StopCommand}" />
                <Border FrameworkElement.Width="16" FrameworkElement.ToolTip="{Binding LastAnswer}">
                    <Image Image.Name="iconInfo" Image.Source="/PixelTuner;component/Images/infoIcon.png" />
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NetworkLayoutTemplate" DataType="{x:Type vm:NetworkViewModel}">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            
            <ComboBox ItemsSource="{Binding Interfaces}" 
                      SelectedItem="{Binding ActiveInterface, Mode=OneWayToSource}" 
                      SelectedIndex="{Binding SelectedInterfaceIdx}" 
                      Grid.Row="0" 
                      Margin="4" 
                      HorizontalContentAlignment="Stretch"
                      IsEnabled="{Binding CanChangeInterface}"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel LastChildFill="True" Grid.Column="0">
                    <Button Content="Connect" Margin="4,2" Command="{Binding ConnectCommand}" Style="{StaticResource WhiteLinkButton}" ></Button>
                </DockPanel>
                <DockPanel LastChildFill="True" Grid.Column="1">
                    <Button Content="Refresh" Margin="4,2" Command="{Binding RefreshCommand}" Style="{StaticResource WhiteLinkButton}" ></Button>
                </DockPanel>
                <DockPanel LastChildFill="True" Grid.Column="2">
                    <Button Content="Disconnect" Margin="4,2" Command="{Binding DisconnectCommand}" Style="{StaticResource WhiteLinkButton}" ></Button>
                </DockPanel>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource WifiDeviceTemplate}"/>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>