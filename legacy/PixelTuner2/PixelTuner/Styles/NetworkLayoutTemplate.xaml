<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PixelTuner.ViewModel"
                    xmlns:vmd="clr-namespace:PixelTuner.ViewModel.Devices">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="WifiDeviceTemplate" DataType="{x:Type vmd:WifiInfoDevice}">
        <Grid Margin="10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="32"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="60"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="IP: " Foreground="White" Grid.Column="0" VerticalAlignment="Center"></TextBlock>
            <TextBlock Text="{Binding IPString}" Foreground="White" Grid.Column="1" VerticalAlignment="Center"></TextBlock>
            <TextBlock Text="Tag: " Foreground="White" Grid.Column="2" VerticalAlignment="Center"></TextBlock>
            <TextBlock Text="{Binding Tag}" Foreground="White" Grid.Column="3" VerticalAlignment="Center"></TextBlock>
            <Rectangle Width="60" Height="26" Grid.Column="3" HorizontalAlignment="Right" ToolTip="{Binding LastAnswer}">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#001a1a1a" Offset="0"></GradientStop>
                        <GradientStop Color="#ef1a1a1a" Offset="1"></GradientStop>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Orientation="Horizontal" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Button Content="Play" Command="{Binding PlayCommand}" Margin="1,2"></Button>
                <Button Content="Stop" Command="{Binding StopCommand}" Margin="1,2"></Button>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NetworkLayoutTemplate" DataType="{x:Type vm:NetworkViewModel}">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            
            <ComboBox ItemsSource="{Binding Interfaces}" 
                      SelectedItem="{Binding ActiveInterface, Mode=OneWayToSource}" 
                      SelectedIndex="0" 
                      Grid.Row="0" 
                      Margin="4" 
                      HorizontalContentAlignment="Stretch"
                      IsEnabled="{Binding CanChangeInterface}"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel LastChildFill="True" Grid.Column="0">
                    <Button Content="Connect" Margin="4,2" Command="{Binding ConnectCommand}" Style="{StaticResource WhiteLinkButton}" ></Button>
                </DockPanel>
                <DockPanel LastChildFill="True" Grid.Column="1">
                    <Button Content="Refresh" Margin="4,2" Command="{Binding RefreshCommand}" Style="{StaticResource WhiteLinkButton}" ></Button>
                </DockPanel>
                <DockPanel LastChildFill="True" Grid.Column="2">
                    <Button Content="Disconnect" Margin="4,2" Command="{Binding DisconnectCommand}" Style="{StaticResource WhiteLinkButton}" ></Button>
                </DockPanel>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource WifiDeviceTemplate}"/>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>