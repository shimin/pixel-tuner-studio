                                </Grid.RowDefinitions>
                                <StackPanel x:Name="descriptionsStack" Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                    <TextBlock Text="{StaticResource Dev_Props_Name}" Margin="0,2,0,0" />
                                    <TextBlock Text="{StaticResource Dev_Props_Channels}" />
                                    <TextBlock Text="{StaticResource Dev_Props_Status}" />
                                </StackPanel>
                                <StackPanel x:Name="valuesStack" Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                                    <TextBlock Text="{Binding FullName}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding ChannelsAmount}" Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding Status}" Margin="0,0,0,0"/>
                                </StackPanel>
                                <ProgressBar 
                                                    x:Name="UploadProgressBar"
                                                    Value="{Binding Progress}" 
