<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PixelTuner.ViewModel">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <DataTemplate x:Key="DevicesLayoutTemplate" DataType="{x:Type vm:DevicesViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="100"></RowDefinition>
            </Grid.RowDefinitions>
            <ListBox x:Name="boxDevicesList" MinWidth="120" MinHeight="120"
                                             Grid.Row="0"
                                             ItemsSource="{Binding Devices, UpdateSourceTrigger=PropertyChanged}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionMode="Single">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}">
                            <TextBlock.ContextMenu>
                                <ContextMenu Visibility="{Binding Busy, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.DataContext}">
                                    <MenuItem Header="{StaticResource Dev_Menu_RefreshBrain}" Command="{Binding UploadFirmwareCommand}"></MenuItem>
                                    <MenuItem Header="{StaticResource Dev_Menu_Upload}"
                                                x:Name="UploadMainMenu"
                                                ItemsSource="{Binding Source={StaticResource RootContext}, Path=Files}"
                                                ItemContainerStyle="{StaticResource DeviceUploadMenuItemStyle}"
                                                Style="{StaticResource DeviceUploadMainMenuItemStyle}">
                                    </MenuItem>
                                    <MenuItem Header="{StaticResource Dev_Menu_Link}" Command="{Binding WriteMacCommand}"></MenuItem>
                                    <MenuItem Header="{StaticResource Dev_Menu_SetAsMaster}" Command="{Binding SetAsMasterCommand}"></MenuItem>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Canvas Grid.Row="1" >
                <Canvas.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=boxDevicesList, Path=SelectedItems.Count}" Value="0">
                                <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <ContentControl Content="{Binding ElementName=boxDevicesList, Path=SelectedItem}">
                    <ContentControl.Resources>

                        <DataTemplate DataType="{x:Type vm:VideoDeviceViewModel}">
                            <Grid HorizontalAlignment="Stretch" 
                                  Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DockPanel}}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="{Binding ElementName=UploadProgressBar, Path=Height}"></RowDefinition>
                                    <RowDefinition Height="16"></RowDefinition>
                                    <RowDefinition Height="16"></RowDefinition>
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="descriptionsStack" Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                    <TextBlock Text="{StaticResource Dev_Props_Name}" Margin="0,2,0,0" />
                                    <TextBlock Text="{StaticResource Dev_Props_Length}" />
                                    <TextBlock Text="{StaticResource Dev_Props_Status}" />
                                    <TextBlock Text="{StaticResource Dev_Props_Tag}"></TextBlock>
                                </StackPanel>
                                <StackPanel x:Name="valuesStack" Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                                    <TextBlock Text="{Binding FullName}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding LedsTotal}" Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding Status}" Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding Tag}" Margin="0"></TextBlock>
                                </StackPanel>
                                <ProgressBar 
                                                    x:Name="UploadProgressBar"
                                                    Value="{Binding Progress}" 
                                                    Minimum="{Binding ProgressMin}" 
                                                    Maximum="{Binding ProgressMax}" 
                                                    Style="{StaticResource OperationProgressBarStyle}"
                                                    Grid.ColumnSpan="2"
                                                    Grid.Row="1"
                                                    Margin="0,2,0,0" />
                                <TextBlock Text="{StaticResource Dev_Props_UpdateNeeded}" 
                                                           Foreground="#d0d010" 
                                                           Margin="0,2,0,0" 
                                                           Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                           Grid.Row="2" Grid.ColumnSpan="2"/>
                                <Button Style="{StaticResource WhiteLinkButton}" 
                                                        Content="{StaticResource Dev_Props_Update}" 
                                                        Command="{Binding AutoUpdateCommand}" 
                                                        Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                        Grid.Row="3" Margin="8,0,0,0" />
                                <Button Style="{StaticResource WhiteLinkButton}" 
                                                        Content="{StaticResource Dev_Props_Postpone}" 
                                                        Command="{Binding UpdatePostponeCommand}" 
                                                        Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                        Grid.Row="3" Grid.Column="1" />
                            </Grid>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:PixelDeviceViewModel}">
                            <Grid HorizontalAlignment="Stretch" 
                                  Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DockPanel}}}">
