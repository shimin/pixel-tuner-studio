                                                           Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                           Grid.Row="2" Grid.ColumnSpan="2"/>
                                <Button Style="{StaticResource WhiteLinkButton}" 
                                                        Content="{StaticResource Dev_Props_Update}" 
                                                        Command="{Binding AutoUpdateCommand}" 
                                                        Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                        Grid.Row="3" Margin="8,0,0,0" />
                                <Button Style="{StaticResource WhiteLinkButton}" 
                                                        Content="{StaticResource Dev_Props_Postpone}" 
                                                        Command="{Binding UpdatePostponeCommand}" 
                                                        Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                        Grid.Row="3" Grid.Column="1" />
                            </Grid>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:LightMasterDeviceViewModel}">
                            <Grid HorizontalAlignment="Stretch" 
                                  Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DockPanel}}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
