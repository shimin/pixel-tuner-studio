<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:PixelTuner.ViewModel"
                    xmlns:dd="clr-namespace:Common.DragDrop;assembly=Common"
                    x:Class="PixelTuner.Styles.CanvasTemplate"
                    x:ClassModifier="internal"
                    >
    <DataTemplate x:Key="CanvasElementTemplate" DataType="{x:Type model:CanvasElementViewModel}">
        <Canvas>
            <Path 
                    Stroke="{Binding Stroke}" 
                    StrokeThickness="1" 
                    Fill="{Binding Fill}" 
                    MouseDown="Path_MouseDown"
                    RenderTransform="{Binding Transform}"
                    Data="{Binding Geometry}">
            </Path>
        </Canvas>
    </DataTemplate>
    
    <DataTemplate x:Key="CanvasTemplate">
        <Viewbox Grid.Row="1" Stretch="Uniform" Loaded="Viewbox_Loaded">
            <Canvas 
                Width="{Binding Clip.Bounds.Width, RelativeSource={RelativeSource Self}}" 
                Height="{Binding Clip.Bounds.Height, RelativeSource={RelativeSource Self}}" 
                Clip="{Binding PageSize}"
                ClipToBounds="True">
                
                <ItemsControl 
                    ItemsSource="{Binding Elements}" 
                    ItemTemplate="{StaticResource CanvasElementTemplate}" 
                    dd:DragDropHelper.IsDragSource="True" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>