<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:PixelTuner.ViewModel"
                    xmlns:dd="clr-namespace:Common.DragDrop;assembly=Common"
                    xmlns:c="clr-namespace:Common.Controls;assembly=Common"
                    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                    x:Class="PixelTuner.Styles.CanvasTemplate"
                    x:ClassModifier="internal">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <DataTemplate x:Key="CanvasElementTemplate" DataType="{x:Type model:CanvasElementViewModel}">
        <ItemsControl>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding Path=OnDoubleClickCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <Canvas>
                <Path c:SizeObserver.Observe="True"
                      c:SizeObserver.ObservedWidth="{Binding ActualWidth, Mode=OneWayToSource}"
                      c:SizeObserver.ObservedHeight="{Binding ActualHeight, Mode=OneWayToSource}"
                      Name="boxPath"
                            Stroke="{Binding Stroke}" 
                            StrokeThickness="1" 
                            Fill="{Binding Fill}"                 
                            RenderTransform="{Binding Transform}"
                            Data="{Binding Geometry}">
                    <Path.ToolTip>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Path}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Width: "></TextBlock>
                                <TextBlock Text="{Binding ColumnsCount}"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Height: "></TextBlock>
                                <TextBlock Text="{Binding RowsCount}"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Active: "></TextBlock>
                                <TextBlock Text="{Binding OrderedLeds.Count}"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Path.ToolTip>
                    <Path.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Markup">
                                <MenuItem Header="Copy" Command="{Binding CopyMarkupCommand}"/>
                                <MenuItem Header="Paste" Command="{Binding PasteMarkupCommand}"/>
                            </MenuItem>
                        </ContextMenu>
                    </Path.ContextMenu>
                </Path>
            </Canvas>
        </ItemsControl>
    </DataTemplate>
    
    <DataTemplate x:Key="CanvasTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Height="32">
                <Button Command="{Binding Source={StaticResource RootContext}, Path=ImportCommand}" Content="{StaticResource ElementMarkup_Import}" Margin="6" Style="{StaticResource WhiteLinkButton}" />
            </StackPanel>
            <Viewbox Grid.Row="1" Stretch="Uniform" DataContext="{Binding Source={StaticResource RootContext}, Path=CanvasModel}">
                <Canvas Width="{Binding Clip.Bounds.Width, RelativeSource={RelativeSource Self}}" 
                    Height="{Binding Clip.Bounds.Height, RelativeSource={RelativeSource Self}}" 
                    Clip="{Binding PageSize}" ClipToBounds="True">

                    <ItemsControl ItemsSource="{Binding Elements}" 
                        ItemTemplate="{StaticResource CanvasElementTemplate}" 
                        dd:DragDropHelper.IsDragSource="True" />
                </Canvas>
            </Viewbox>
        </Grid>
    </DataTemplate>
</ResourceDictionary>