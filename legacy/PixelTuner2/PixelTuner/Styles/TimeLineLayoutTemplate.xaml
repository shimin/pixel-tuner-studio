<ResourceDictionary x:Class="PixelTuner.Styles.TimeLineLayoutTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    
                    xmlns:acb="clr-namespace:AttachedCommandBehavior;assembly=Common"
                    xmlns:ct="clr-namespace:Common.Controls;assembly=Common"
                    xmlns:cv="clr-namespace:PixelTuner.Converters"
                    xmlns:vm="clr-namespace:PixelTuner.ViewModel"
                    xmlns:tlw="clr-namespace:PixelTuner.Controls.ThumbListView">


    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Common;component/Styles/TimeLineItem.xaml"></ResourceDictionary>
        <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <cv:LogConverter x:Key="LogUnitSizeConverter"/>
    
    <SolidColorBrush x:Key="NormalItemBrush" Color="#bababa" />
    
    <LinearGradientBrush x:Key="ControlsBackBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="Absolute">
        <GradientStop Offset="0.5" Color="#cfbababa"/>
        <GradientStop Offset="1" Color="#00bababa"/>
        <LinearGradientBrush.Transform>
            <ScaleTransform ScaleX="160"/>
        </LinearGradientBrush.Transform>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SelectedItemBrush" StartPoint="0,0" EndPoint="1,1" SpreadMethod="Repeat" MappingMode="Absolute">
        <GradientStop Offset="0" Color="#cfffffff"/>
        <GradientStop Offset="0.5" Color="#cfffffff"/>
        <GradientStop Offset="0.5" Color="#c04c4c4c"/>
        <GradientStop Offset="1" Color="#c04c4c4c"/>

        <LinearGradientBrush.Transform>
            <ScaleTransform ScaleX="2" ScaleY="2"/>
        </LinearGradientBrush.Transform>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SelectedLineBrush" StartPoint="0,0" EndPoint="1,1" SpreadMethod="Repeat" MappingMode="Absolute">
        <GradientStop Offset="0" Color="#a0a0a0a0"/>
        <GradientStop Offset="0.5" Color="#a0a0a0a0"/>
        <GradientStop Offset="0.5" Color="#c00c0c0c"/>
        <GradientStop Offset="1" Color="#c00c0c0c"/>

        <LinearGradientBrush.Transform>
            <ScaleTransform ScaleX="2" ScaleY="2"/>
        </LinearGradientBrush.Transform>
    </LinearGradientBrush>

    <DataTemplate x:Key="TimelineItemTemplate" DataType="{x:Type vm:TimeLineItemViewModel}">
        <Border x:Name="boxItemBorder"
                BorderThickness="1"
                BorderBrush="White"
                CornerRadius="3"
                Margin="0,10,0,10"
                Height="80"
                Background="{StaticResource NormalItemBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource ControlsBackBrush}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="15" Height="15">
                            <Image Source="{Binding StartIcon}"/>
                        </Border>
                        <TextBlock Grid.Column="0" Text="{Binding Path=Start}" />
                    </StackPanel>
                        <Button Name="boxImageButton" PreviewMouseDoubleClick="ChildPreviewMouseLeftButtonDown">
                            <acb:CommandBehaviorCollection.Behaviors>
                                <acb:BehaviorBinding Event="MouseDoubleClick" Command="{Binding EditMe}" />
                            </acb:CommandBehaviorCollection.Behaviors>
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Height="44" MinWidth="200">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ImageSource, UpdateSourceTrigger=PropertyChanged}" Stretch="Uniform" AlignmentX="Left" />
                                        </Border.Background>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{StaticResource Item_Menu_Replace}" Command="{Binding ReplaceCommand}"/>
                                                <MenuItem Header="{StaticResource Item_Menu_Split}" Command="{Binding SplitCommand}"/>
                                                <MenuItem Header="{StaticResource Item_Menu_SetRepeatCount}" Command="{Binding RepeatCommand}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="15" Height="15">
                            <Image Source="{Binding EndIcon}"/>
                        </Border>
                        <TextBlock Text="{Binding Path=End}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                            <Border Width="16" Height="16" Margin="-1,0,0,0" ToolTip="{StaticResource Item_Stretching}">
                                <Image Source="/PixelTuner;component/Images/scale-stretching.png"/>
                            </Border>
                            <ct:TriangleSlider Height="12" 
                                           Width="48"
                                           MinValue="0" 
                                           MaxValue="40" 
                                           Margin="-2,2,4,0"
                                           IsEnabled="False"
                                           Opacity="0.1"
                                           ToolTip="{StaticResource Item_Stretching}"
                                           PreviewMouseLeftButtonDown="ChildPreviewMouseLeftButtonDown"
                                           Value="{Binding Path=Parent.DataContext.Stretching, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>
                <StackPanel Orientation="Vertical" Grid.Column="1" Background="{StaticResource NormalItemBrush}">
                    <Button Margin="0,2,0,0" Command="{Binding DisposeMe}" PreviewMouseLeftButtonDown="ChildPreviewMouseLeftButtonDown">
                        <Button.Template>
                            <ControlTemplate>
                                <Border Width="16" Height="14">
                                    <Image x:Name="RemoveBtnImage" Source="/PixelTuner;component/Images/PinClose_Dark.png"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="Source" Value="/PixelTuner;component/Images/PinClose.png" TargetName="RemoveBtnImage"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Margin="0,2,0,0" Command="{Binding EditMe}" PreviewMouseLeftButtonDown="ChildPreviewMouseLeftButtonDown">
                        <Button.Template>
                            <ControlTemplate>
                                <Border Width="16" Height="14">
                                    <Image x:Name="EditBtnImage" Source="/PixelTuner;component/Images/PenEdit_Dark.png"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="Source" Value="/PixelTuner;component/Images/PenEdit.png" TargetName="EditBtnImage"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Margin="0,2,0,0" Command="{Binding SwitchLaserOn}" PreviewMouseLeftButtonDown="ChildPreviewMouseLeftButtonDown" ToolTip="{StaticResource Item_SwitchLaserOnOffToolTip}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border Width="16" Height="14">
                                    <Grid>
                                        <Ellipse Fill="{Binding LaserOnButtonColor, Mode=OneWay}" Height="12" Width="12" Stroke="Black"></Ellipse>
                                        <TextBlock HorizontalAlignment="Center" Text="L" FontSize="8" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="true">
                <Setter Property="Background" Value="{StaticResource SelectedItemBrush}" TargetName="boxItemBorder"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TimeLineLayoutTemplate" DataType="{x:Type vm:TimeLineViewModel}">
        <ItemsControl>
            <Border x:Name="boxTimelineBorder" BorderThickness="1" BorderBrush="{Binding Background}">
                <Grid x:Name="grid" SizeChanged="grid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="boxTimelineTools" Grid.Column="0" Background="#4a4a4a">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Button Height="14" Margin="4,3,2,0" Style="{StaticResource ButtonUpStyle}" Command="{Binding MoveUp}"></Button>
                            <Button Height="14" Margin="4,0,2,1" Style="{StaticResource ButtonDownStyle}" Command="{Binding MoveDown}"></Button>
                            <Button Height="16" Margin="4,1,2,1" Style="{StaticResource ButtonDeleteLineStyle}" Command="{Binding DeleteLine}"></Button>
                            <Button Height="16" Margin="4,1,2,1" Style="{StaticResource ButtonCloneStyle}" Command="{Binding CloneLine}"></Button>
                        </StackPanel>
                        <TextBlock Text="{Binding LineHeight}" Grid.Row="1" TextAlignment="Center" Visibility="{Binding IsLineHeightVisible}" Foreground="#8f8f8f" />
                    </Grid>
                    <ct:TimeLineControl 
                        x:Name="TimeLine"
                        Grid.Column="1" 
                        Grid.RowSpan="3" 
                        Height="100"
                        ViewLevel="Seconds"
                        HorizontalAlignment="Left"
                        ManipulationMode="Free"
                        MinimumUnitWidth="20"
                        DrawTimeGrid="False"
                        FocusOnItem="False"
                        SynchedWithSiblings="True"
                        AnchorStep="{Binding Source={StaticResource RootContext}, Path=AnchorStep}"
                        Background="{Binding Background}"
                        DefaultTimeInterval="{Binding DefaultTimeInterval}" 
                        Manager="{Binding DragManager}"
                        StartDate="{Binding Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        UnitSize="{Binding Path=Parent.UnitSize}"
                        Items="{Binding Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemTemplate="{StaticResource TimelineItemTemplate}"/>
                </Grid>
            </Border>
        </ItemsControl>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="true">
                <Setter Property="Background" Value="#ff323232" TargetName="boxTimelineTools"/>
                <Setter Property="BorderBrush" Value="{StaticResource SelectedLineBrush}" TargetName="boxTimelineBorder"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>