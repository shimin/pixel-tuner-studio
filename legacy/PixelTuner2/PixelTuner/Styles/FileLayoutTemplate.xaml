<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ct="clr-namespace:PixelTuner.Controls"
                    xmlns:vm="clr-namespace:PixelTuner.ViewModel">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
        <ResourceDictionary Source="/PixelTuner;component/Styles/TimeLineLayoutTemplate.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="FileLayoutTemplate" DataType="{x:Type vm:FileViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="{Binding MemoryListHeight, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="0"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="NewBtn" Grid.Row="0" Grid.Column="0" Margin="4,0,0,2" 
                                            Content="{StaticResource Doc_Btn_AddLine}" 
                                            Command="{Binding AddLine}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="16,4,4,0" Foreground="{StaticResource TextBrush}" Text="{StaticResource Doc_Lbl_Scale}"/>
            <Slider Grid.Row="0" Grid.Column="2" x:Name="Slider_Scale" Margin="2" Minimum="1" Maximum="60" Value="{Binding UnitSize}"/>
            <TextBlock Grid.Column="3" Margin="16,4,4,0" Foreground="{StaticResource TextBrush}" Text="{StaticResource Doc_Lbl_Height}" />
            <ct:NumericUpDownControl 
                                        Grid.Column="4" 
                                        Margin="4,2,2,0" 
                                        MaxValue="100"
                                        MinValue="5"
                                        Step="5"
                                        IsEnabled="{Binding Path=Parent.DataContext.LineHeightChangingAvailable, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        Value="{Binding Path=Parent.DataContext.LineHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid x:Name="MemoryGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                                                Height="{Binding MemoryListHeight, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding Visibility, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Margin="4,0,0,1" Foreground="{StaticResource TextBrush}" Text="{StaticResource Doc_Lbl_MemoryUsed}" />
                <ListBox 
                                            x:Name="MemoryListBox"
                                            Margin="0,0,0,0"
                                            Grid.Row="1"                                        
                                            ItemsSource="{Binding Devices}"
                                            BorderBrush="Transparent"
                                            Background="Transparent"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            Style="{StaticResource disabledListBoxSelection}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Height="12" Orientation="Horizontal" Margin="4,2,0,1">
                                <TextBlock Text="{Binding FullName}" MinWidth="84" Margin="8,-2,6,1"/>
                                <ProgressBar 
                                                            Width="500"
                                                            Value="{Binding ElementName=MemoryGrid, Path=Parent.DataContext.ProjectSize, Mode=OneWay}" 
                                                            Minimum="0" 
                                                            Maximum="{Binding MaxMemory}" 
                                                            Margin="0,0,0,0"/>
                                <TextBlock Text="{Binding ElementName=MemoryGrid, Path=Parent.DataContext.ProjectSize, Mode=OneWay}" Margin="8,-2,1,0" />
                                <TextBlock Text="/" Margin="0,-2,0,0" />
                                <TextBlock Text="{Binding MaxMemory, Mode=OneWay}" Margin="1,-2,6,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ScrollViewer Grid.Row="2"
                                                    Grid.ColumnSpan="6"
                                                    Grid.RowSpan="1"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalScrollBarVisibility="Auto"
                                                    VerticalScrollBarVisibility="Auto"
                                                    VerticalAlignment="Stretch">
                <StackPanel x:Name="timelineStackPanel" Orientation="Vertical">
                    <ItemsControl Grid.Row="2" 
                                                            ItemTemplate="{StaticResource TimeLineLayoutTemplate}"
                                                            ItemsSource="{Binding Path=TimeLines, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

</ResourceDictionary>