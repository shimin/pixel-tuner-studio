    </Style>
    
    <Style x:Key="OperationProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="12"></Setter>
        <Setter Property="Margin" Value="0,0,0,2"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusRaw}" Value="2">
                <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusRaw}" Value="3">
                <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusRaw}" Value="4">
                <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Name="DeviceUploadMainMenuItemStyle" x:Key="DeviceUploadMainMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource RootContext}, Path=Files.Count}" Value="0">
                <Setter Property="IsEnabled" Value="false"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Name="DeviceUploadMenuItemStyle" x:Key="DeviceUploadMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.UploadCommand, 
                RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}"></Setter>
        <Setter Property="CommandParameter" Value="{Binding .}"></Setter>
    </Style>
    
    <Style x:Key="disabledListBoxSelection">
        <Style.Resources>
            <!-- Background of selected item when focussed -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
            <!-- Background of selected item when not focussed -->
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ffffff" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ffffff" />
        </Style.Resources>
    </Style>
    
    <Style x:Key="WhiteLinkButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock TextDecorations="Underline" Margin="0">
                            <ContentPresenter />
                    </TextBlock>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Foreground" Value="Red" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="#888888" />
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="BlueLinkButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock TextDecorations="Underline" Margin="0,0,0,0">
                            <ContentPresenter />
                    </TextBlock>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#0000ff" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Foreground" Value="Red" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="#888888" />
            </Trigger>
            <!--<EventTrigger RoutedEvent="PreviewMouseDown">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <SolidColorBrush Color="Black"></SolidColorBrush>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>-->
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>