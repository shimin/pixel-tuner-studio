<Window x:Class="PixelTuner.RepeatItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Focusable="True"
        PreviewKeyDown="Window_KeyDown"
        Height="91" Width="170" WindowStyle="None" WindowStartupLocation="Manual" ContentRendered="Window_ContentRendered" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Grid Margin="6,3,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="2" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Width="15" Height="15">
            <Image Source="/PixelTuner;component/Images/scale-stretching.png"/>
        </Border>
        <xctk:DoubleUpDown Grid.ColumnSpan="5" Value="1" Name="boxRepeatCount" ValueChanged="numericValueChanged" FontWeight="{Binding DurationWeight, Mode=OneWay}" Grid.Column="1" Grid.Row="0" Minimum="0" Maximum="1000" IsTabStop="True" Margin="0,1,0,1" TabIndex="30" ParsingNumberStyle="Integer" RenderTransformOrigin="0,0" SelectAllOnGotFocus="True" FormatString=""></xctk:DoubleUpDown>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Orientation="Horizontal">
            <Button Content="OK" TabIndex="90" Width="74" IsDefault="True" Click="OKButton_Click" />
            <Button Content="Cancel" TabIndex="100" Width="74" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
