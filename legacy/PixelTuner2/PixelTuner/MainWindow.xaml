<Window x:Class="PixelTuner.MainWindow"
        x:Name="MainWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelTuner" Height="525" Width="960" WindowStyle="SingleBorderWindow" 
        Icon="/PixelTuner;component/Files/PixelTuner.ico"
        Style="{DynamicResource WindowStyle}"
        
        xmlns:avalonDock="http://avalondock.codeplex.com"
        xmlns:dd="clr-namespace:Core.DragDrop;assembly=Core"
        xmlns:tlw="clr-namespace:PixelTuner.Controls.ThumbListView"
        
        xmlns:pt="clr-namespace:PixelTuner"
        xmlns:vm="clr-namespace:PixelTuner.ViewModel"
        xmlns:ct="clr-namespace:PixelTuner.Controls"
        xmlns:cv="clr-namespace:PixelTuner.Converters"
        xmlns:sl="clr-namespace:PixelTuner.Selectors"

        Activated="MainWnd_Activated"
        Loaded="Window_Loaded" Closing="Window_Closing">
    
    <Window.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PixelTuner;component/Styles/FileLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/ImagesLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        
            <DataTemplate x:Key="DevicesLayoutTemplate" DataType="{x:Type vm:DevicesViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="100"></RowDefinition>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="boxDevicesList" MinWidth="120" MinHeight="120"
                                             Grid.Row="0"
                                             ItemsSource="{Binding Devices, UpdateSourceTrigger=PropertyChanged}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionMode="Single">
                        <ListBox.Style>
                            <Style>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=boxDevicesList, Path=SelectedItem.Busy}" Value="true">
                                        <Setter Property="ListBox.IsEnabled" Value="false"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.DataContext}">
                                            <MenuItem Header="{StaticResource Dev_Menu_RefreshBrain}" Command="{Binding UploadFirmwareCommand}"></MenuItem>
                                            <MenuItem Header="{StaticResource Dev_Menu_Upload}"
                                                        x:Name="UploadMainMenu"
                                                        ItemsSource="{Binding Source={StaticResource RootContext}, Path=Files}"
                                                        ItemContainerStyle="{StaticResource DeviceUploadMenuItemStyle}"
                                                        Style="{StaticResource DeviceUploadMainMenuItemStyle}">
                                            </MenuItem>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Canvas Grid.Row="1" >
                        <Canvas.Style>
                            <Style>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=boxDevicesList, Path=SelectedItems.Count}" Value="0">
                                        <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <StackPanel DataContext="{Binding ElementName=boxDevicesList, Path=SelectedItem}" Orientation="Vertical">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="{Binding ElementName=UploadProgressBar, Path=Height}"></RowDefinition>
                                    <RowDefinition Height="16"></RowDefinition>
                                    <RowDefinition Height="16"></RowDefinition>
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="descriptionsStack" Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                    <TextBlock Text="{StaticResource Dev_Props_Name}" Margin="0,2,0,0" />
                                    <TextBlock Text="{StaticResource Dev_Props_Power}" />
                                    <TextBlock Text="{StaticResource Dev_Props_Length}" />
                                    <TextBlock Text="{StaticResource Dev_Props_Status}" />
                                </StackPanel>
                                <StackPanel x:Name="valuesStack" Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                                    <TextBlock Text="{Binding FullName}" Margin="0,3,0,0"/>
                                    <ProgressBar Value="{Binding EnergyLevel, Mode=OneWay}" Margin="0,3,0,0" Style="{StaticResource ProgressBarStyle}"/>
                                    <TextBlock Text="{Binding LedsTotal}" Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding Status}" Margin="0,0,0,0"/>
                                </StackPanel>
                                <ProgressBar 
                                                    x:Name="UploadProgressBar"
                                                    Value="{Binding Progress}" 
                                                    Minimum="{Binding ProgressMin}" 
                                                    Maximum="{Binding ProgressMax}" 
                                                    Style="{StaticResource OperationProgressBarStyle}"
                                                    Grid.ColumnSpan="2"
                                                    Grid.Row="1"
                                                    Margin="0,2,0,0" />
                                <TextBlock Text="{StaticResource Dev_Props_UpdateNeeded}" 
                                                           Foreground="#d0d010" 
                                                           Margin="0,2,0,0" 
                                                           Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                           Grid.Row="2" Grid.ColumnSpan="2"/>
                                <Button Style="{StaticResource WhiteLinkButton}" 
                                                        Content="{StaticResource Dev_Props_Update}" 
                                                        Command="{Binding AutoUpdateCommand}" 
                                                        Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                        Grid.Row="3" Margin="8,0,0,0" />
                                <Button Style="{StaticResource WhiteLinkButton}" 
                                                        Content="{StaticResource Dev_Props_Postpone}" 
                                                        Command="{Binding UpdatePostponeCommand}" 
                                                        Visibility="{Binding UpdateNeeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                                                        Grid.Row="3" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </Canvas>
                </Grid>
            </DataTemplate>

            <cv:ActiveDocumentConverter x:Key="ActiveDocumentConverter"/>
        
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        
        <Menu Padding="0">
            <MenuItem Header="{StaticResource Menu_File}">
                <MenuItem Header="{StaticResource Menu_File_New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{StaticResource Menu_File_Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="{StaticResource Menu_File_Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="{StaticResource Menu_File_SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="{StaticResource Menu_File_Close}" Command="{Binding CloseCommand}" InputGestureText="Ctrl+W"/>
                <MenuItem Header="{StaticResource Menu_File_Exit}" Click="ExitApplication"/>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Window}">
                <MenuItem Header="{StaticResource Menu_Window_Projects}" IsCheckable="True" IsChecked="{Binding ProjectsModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                <MenuItem Header="{StaticResource Menu_Window_Devices}" IsCheckable="True" IsChecked="{Binding DevicesModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                <MenuItem Header="{StaticResource Menu_Window_Images}" IsCheckable="True" IsChecked="{Binding ImagesModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Settings}">
                <MenuItem Header="{StaticResource Menu_Settings_Defaults}" Command="{Binding AdjustDefaultsCommand}" InputGestureText="Alt+P"/>
            </MenuItem>
        </Menu>

        <avalonDock:DockingManager Name="dockManager" 
                                   DocumentsSource="{Binding Files}"
                                   AnchorablesSource="{Binding Tools}"
                                   ActiveContent="{Binding ActiveDocument, Mode=TwoWay, Converter={StaticResource ActiveDocumentConverter}}"
                                   Grid.Row="1">
            <avalonDock:DockingManager.Theme>
                <avalonDock:DefaultTheme/>
            </avalonDock:DockingManager.Theme>
            
            <avalonDock:DockingManager.LayoutItemTemplateSelector>
                <sl:PanesTemplateSelector>
                    <sl:PanesTemplateSelector.FileViewTemplate>
                        <StaticResource ResourceKey="FileLayoutTemplate"></StaticResource>
                    </sl:PanesTemplateSelector.FileViewTemplate>
                    <sl:PanesTemplateSelector.DevicesViewTemplate>
                        <StaticResource ResourceKey="DevicesLayoutTemplate"></StaticResource>
                    </sl:PanesTemplateSelector.DevicesViewTemplate>
                    <sl:PanesTemplateSelector.ProjectsViewTemplate>
                        <DataTemplate>
                            <ListBox x:Name="boxProjectsList" MinWidth="120" MinHeight="120" ItemsSource="{Binding Files}"></ListBox>
                        </DataTemplate>
                    </sl:PanesTemplateSelector.ProjectsViewTemplate>
                    <sl:PanesTemplateSelector.ImagesViewTemplate>
                        <StaticResource ResourceKey="ImagesLayoutTemplate"></StaticResource>
                    </sl:PanesTemplateSelector.ImagesViewTemplate>
                </sl:PanesTemplateSelector>
            </avalonDock:DockingManager.LayoutItemTemplateSelector>
            
            <avalonDock:DockingManager.LayoutItemContainerStyleSelector>
                <sl:PanesStyleSelector>
                    <sl:PanesStyleSelector.ToolStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="Visibility" Value="{Binding Model.IsVisible, Mode=TwoWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </sl:PanesStyleSelector.ToolStyle>
                    <sl:PanesStyleSelector.FileStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.FileName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Setter Property="ToolTip" Value="{Binding Model.FilePath}"/>
                            <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </sl:PanesStyleSelector.FileStyle>
                </sl:PanesStyleSelector>
            </avalonDock:DockingManager.LayoutItemContainerStyleSelector>
            
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        <avalonDock:LayoutAnchorablePane TargetContentID="ProjectsTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane TargetContentID="DevicesTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>
                    <avalonDock:LayoutPanel Orientation="Vertical" >
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane />
                        </avalonDock:LayoutDocumentPaneGroup>
                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="100" DockHeight="120" DockMinHeight="80" DockMinWidth="80">
                            <avalonDock:LayoutAnchorablePane TargetContentID="ImagesTool" />
                        </avalonDock:LayoutAnchorablePaneGroup>
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        
        </avalonDock:DockingManager>

        <StatusBar Grid.Row="2">
            <StatusBarItem Content="Pixel Tuner" Margin="2,0,0,2"/>
            <StatusBarItem Content="{Binding AssemblyVersion}" Margin="0,0,2,2"/>
            <StatusBarItem >
                <Button Style="{StaticResource BlueLinkButton}" Content="{StaticResource Dev_Props_Update}" Command="{Binding UpdateCommand}" Visibility="{Binding UpdatesAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Margin="8,-4,0,0"></Button>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}"></KeyBinding>
        <KeyBinding Gesture="Alt+P" Command="{Binding AdjustDefaultsCommand}"></KeyBinding>
    </Window.InputBindings>
</Window>
