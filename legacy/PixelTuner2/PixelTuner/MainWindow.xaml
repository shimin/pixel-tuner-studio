<Window x:Class="PixelTuner.MainWindow"
        x:Name="MainWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelTuner" Height="525" Width="960" WindowStyle="SingleBorderWindow" 
        Icon="/PixelTuner;component/Images/PixelTuner.ico"
        Style="{DynamicResource WindowStyle}"
        
        xmlns:avalonDock="http://avalondock.codeplex.com"
        xmlns:tt="clr-namespace:Core;assembly=Core"
        xmlns:l="clr-namespace:PixelTuner.ListViewStyle;assembly=Appearance"
        xmlns:dd="clr-namespace:Core.DragDrop;assembly=Core"
        xmlns:local="clr-namespace:PixelTuner"
        xmlns:service="clr-namespace:PixelTuner.Service"

        Activated="MainWnd_Activated"
        Loaded="Window_Loaded" Closing="Window_Closing">
    
<Window.Resources>
        <Color R="255"
               G="255"
               B="255"
               A="180"
               x:Key="BgColor" />
        <Color R="240"
               G="240"
               B="240"
               A="220"
               x:Key="SelectedBgColor" />
        <SolidColorBrush Color="{StaticResource BgColor}" x:Key="BgBrush" />
        <SolidColorBrush Color="#ffffff" x:Key="TextBrush" />
        <BooleanToVisibilityConverter x:Key="OldschoolVisibilityConverter" />
        <Style TargetType="{x:Type tt:TimeLineItemControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type tt:TimeLineItemControl}">
                        <Grid>
                            <Border Background="Blue"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_ContentHostPART_ContentHost" />
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_LeftIndicator">
                                <ContentPresenter.Content>
                                    <Button />
                                </ContentPresenter.Content>

                            </ContentPresenter>
                            <ContentPresenter HorizontalAlignment="Right"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_RightIndicator">
                                <ContentPresenter.Content>
                                    <Button />
                                </ContentPresenter.Content>

                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonDownStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border MinWidth="6" MinHeight="4">
                            <Image x:Name="DownImage" Source="/PixelTuner;component/Images/_grey_Arrow-Down.png"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-DownLight.png" TargetName="DownImage"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-DownDisabled.png" TargetName="DownImage"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonUpStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border MinWidth="6" MinHeight="4">
                            <Image x:Name="UpImage" Source="/PixelTuner;component/Images/_grey_Arrow-Up.png"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-UpLight.png" TargetName="UpImage"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-UpDisabled.png" TargetName="UpImage"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonDeleteLineStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Width="16" Height="14">
                            <Image x:Name="UpImage" Source="/PixelTuner;component/Images/red_cross.png"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/red_crossLight.png" TargetName="UpImage"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/red_crossDisabled.png" TargetName="UpImage"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="MinHeight" Value="12"></Setter>
            <Setter Property="Margin" Value="0,0,0,2"></Setter>
        </Style>
        <Style x:Key="OperationProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="MinHeight" Value="12"></Setter>
            <Setter Property="Margin" Value="0,0,0,2"></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusRaw}" Value="2">
                    <!--<MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding StatusRaw}" Value="2"></Condition>
                        <Condition Binding="{Binding StatusRaw}" Value="3"></Condition>
                        <Condition Binding="{Binding StatusRaw}" Value="4"></Condition>
                    </MultiDataTrigger.Conditions>-->
                    <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusRaw}" Value="3">
                    <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusRaw}" Value="4">
                    <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Name="DeviceUploadMainMenuItemStyle" x:Key="DeviceUploadMainMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={StaticResource RootContext}, Path=Files.Count}" Value="0">
                    <Setter Property="IsEnabled" Value="false"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Name="DeviceUploadMenuItemStyle" x:Key="DeviceUploadMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.UploadCommand, 
                RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}"></Setter>
            <Setter Property="CommandParameter" Value="{Binding .}"></Setter>
        </Style>
        <Style x:Key="disabledListBoxSelection">
            <Style.Resources>
                <!-- Background of selected item when focussed -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                <!-- Background of selected item when not focussed -->
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ffffff" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ffffff" />
            </Style.Resources>
        </Style>
        <Style
            x:Key="LinkButton"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock TextDecorations="Underline">
                            <ContentPresenter />
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Foreground" Value="Red" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="BlueLinkButton"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock TextDecorations="Underline" Margin="0,0,0,0">
                            <ContentPresenter />
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#0000ff" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Foreground" Value="Red" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate  DataType="{x:Type l:ThumbnailFileItem}"
                       x:Key="ItemTemplateProperty">
            <Border BorderThickness="1"
                    BorderBrush="White"
                    CornerRadius="3"
                    Margin="0,10,0,10"
                    Height="96"
                    Background="{Binding NormalBackground}">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="SizeChanged">
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Path=Start}" />
                        <Button Grid.Column="1" Margin="0,2,0,0" Command="{Binding DisposeMe}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Width="16" Height="14">
                                        <Image x:Name="RemoveBtnImage" Source="/PixelTuner;component/Images/PinClose_Dark.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter Property="Source" Value="/PixelTuner;component/Images/PinClose.png" TargetName="RemoveBtnImage"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <Border Height="44" MinWidth="200">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ImageSource}" Stretch="Uniform" AlignmentX="Left" />
                        </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding Path=End}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Item_Stretching}" Margin="0,2,4,0"/>
                        <local:TriangleSlider Height="12" 
                                              Width="48"
                                              MinValue="4" 
                                              MaxValue="46" 
                                              Margin="0,2,4,0"
                                              Value="{Binding Path=Parent.DataContext.Stretching, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <!--<Slider Height="12" Minimum="4" Maximum="32" Width="44" 
                                Margin="0,-2,0,-2"
                                Value="{Binding Path=Parent.DataContext.Stretching, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>-->
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate  DataType="{x:Type local:TimeLineViewModel}"
                       x:Key="TimeLineLayoutTemplate">
            <ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Background="#4a4a4a">
                        <Button Height="14" Margin="4,3,2,0" Style="{StaticResource ButtonUpStyle}" Command="{Binding MoveUp}"></Button>
                        <Button Height="14" Margin="4,0,2,1" Style="{StaticResource ButtonDownStyle}" Command="{Binding MoveDown}"></Button>
                        <Button Height="16" Margin="4,1,2,1" Style="{StaticResource ButtonDeleteLineStyle}" Command="{Binding DeleteLine}"></Button>
                    </StackPanel>
                    <tt:TimeLineControl 
                        Grid.Column="1" 
                        Grid.RowSpan="3" 
                        Height="112"
                        Items="{Binding Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemTemplate="{StaticResource ItemTemplateProperty}"
                        ViewLevel="Seconds"
                        HorizontalAlignment="Left"
                        x:Name="TimeLine"
                        StartDate="{Binding Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        UnitSize="{Binding ElementName=Slider_Scale, Path=Value}"
                        MinimumUnitWidth="20"
                        Background="{Binding Background}"
                        DrawTimeGrid="False"
                        MinWidth="740"
                        DefaultTimeInterval="{Binding DefaultTimeInterval}"
                        SynchedWithSiblings="True" />
                </Grid>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate  DataType="{x:Type local:FileViewModel}"
                       x:Key="FileLayoutTemplate">
                        <ItemsControl Grid.Row="1" 
                                      ItemTemplate="{StaticResource TimeLineLayoutTemplate}"
                                      ItemsSource="{Binding Path=TimeLines, Mode=TwoWay}" />
        </DataTemplate>
        <local:ActiveDocumentConverter x:Key="ActiveDocumentConverter"/>
        <avalonDock:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        
        <Menu Padding="0">
            <MenuItem Header="{StaticResource Menu_File}">
                <MenuItem Header="{StaticResource Menu_File_New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{StaticResource Menu_File_Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="{StaticResource Menu_File_Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="{StaticResource Menu_File_SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="{StaticResource Menu_File_Close}" Command="{Binding CloseCommand}" InputGestureText="Ctrl+W"/>
                <MenuItem Header="{StaticResource Menu_File_Exit}" Click="ExitApplication"/>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Window}">
                <MenuItem Header="{StaticResource Menu_Window_Projects}" IsCheckable="True" IsChecked="{Binding ProjectsModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                <MenuItem Header="{StaticResource Menu_Window_Devices}" IsCheckable="True" IsChecked="{Binding DevicesModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                <MenuItem Header="{StaticResource Menu_Window_Images}" IsCheckable="True" IsChecked="{Binding ImagesModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Settings}">
                <MenuItem Header="{StaticResource Menu_Settings_Defaults}" Command="{Binding AdjustDefaultsCommand}"/>
            </MenuItem>
        </Menu>

        <avalonDock:DockingManager Name="dockManager" 
                                   DocumentsSource="{Binding Files}"
                                   AnchorablesSource="{Binding Tools}"
                                   ActiveContent="{Binding ActiveDocument, Mode=TwoWay, Converter={StaticResource ActiveDocumentConverter}}"
                                   Grid.Row="1">
            <avalonDock:DockingManager.Theme>
                <avalonDock:DefaultTheme/>
            </avalonDock:DockingManager.Theme>

            <avalonDock:DockingManager.LayoutItemTemplateSelector>
                <local:PanesTemplateSelector>
                    <local:PanesTemplateSelector.FileViewTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="{Binding MemoryListHeight, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="0"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="0"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="NewBtn" Grid.Row="0" Grid.Column="0" Margin="4,0,0,2" 
                                        Content="{StaticResource Doc_Btn_AddLine}" 
                                        Command="{Binding AddLine}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="16,4,4,0" Foreground="{StaticResource TextBrush}" Text="{StaticResource Doc_Lbl_Scale}"/>
                                <Slider Grid.Row="0" Grid.Column="2" x:Name="Slider_Scale" Margin="2" Minimum="1" Maximum="60" Value="{Binding UnitSize}"/>
                                <TextBlock Grid.Column="3" Margin="16,4,4,0" Foreground="{StaticResource TextBrush}" Text="{StaticResource Doc_Lbl_Height}" />
                                <local:NumericUpDownControl 
                                    Grid.Column="4" 
                                    Margin="4,2,2,0" 
                                    MaxValue="100"
                                    MinValue="5"
                                    Step="5"
                                    IsEnabled="{Binding Path=Parent.DataContext.LineHeightChangingAvailable, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    Value="{Binding Path=Parent.DataContext.LineHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid x:Name="MemoryGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                                            Height="{Binding MemoryListHeight, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding Visibility, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Margin="4,0,0,1" Foreground="{StaticResource TextBrush}" Text="{StaticResource Doc_Lbl_MemoryUsed}" />
                                    <ListBox 
                                        x:Name="MemoryListBox"
                                        Margin="0,0,0,0"
                                        Grid.Row="1"                                        
                                        ItemsSource="{Binding Source={x:Static Member=service:DeviceHelper.Devices}, 
                                        UpdateSourceTrigger=PropertyChanged}"
                                        BorderBrush="Transparent"
                                        Background="Transparent"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        Style="{StaticResource disabledListBoxSelection}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Height="12" Orientation="Horizontal" Margin="4,2,0,1">
                                                    <TextBlock Text="{Binding FullName}" MinWidth="84" Margin="8,-2,6,1"/>
                                                    <ProgressBar 
                                                        Width="500"
                                                        Value="{Binding ElementName=MemoryGrid, Path=Parent.DataContext.ProjectSize, Mode=OneWay}" 
                                                        Minimum="0" 
                                                        Maximum="{Binding MaxMemory}" 
                                                        Margin="0,0,0,0"/>
                                                    <TextBlock Text="{Binding ElementName=MemoryGrid, Path=Parent.DataContext.ProjectSize, Mode=OneWay}" Margin="8,-2,1,0" />
                                                    <TextBlock Text="/" Margin="0,-2,0,0" />
                                                    <TextBlock Text="{Binding MaxMemory, Mode=OneWay}" Margin="1,-2,6,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <ScrollViewer Grid.Row="2"
                                                Grid.ColumnSpan="6"
                                                Grid.RowSpan="1"
                                                HorizontalAlignment="Stretch"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalAlignment="Stretch">
                                    <StackPanel x:Name="timelineStackPanel" Orientation="Vertical">
                                        <ItemsControl Grid.Row="2" 
                                                        ItemTemplate="{StaticResource TimeLineLayoutTemplate}"
                                                        ItemsSource="{Binding Path=TimeLines, Mode=TwoWay}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </local:PanesTemplateSelector.FileViewTemplate>
                    <local:PanesTemplateSelector.DevicesViewTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="100"></RowDefinition>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="boxDevicesList" MinWidth="120" MinHeight="120"
                                         Grid.Row="0"
                                         ItemsSource="{Binding Source={x:Static Member=service:DeviceHelper.Devices}, UpdateSourceTrigger=PropertyChanged}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Single"
                                         >
                                    <ListBox.Style>
                                        <Style>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=boxDevicesList, Path=SelectedItem.DeviceBusy}" Value="true">
                                                    <Setter Property="ListBox.IsEnabled" Value="false"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.DataContext}">
                                                        <MenuItem Header="{StaticResource Dev_Menu_RefreshBrain}" Command="{Binding UploadFirmwareCommand}"></MenuItem>
                                                        <MenuItem Header="{StaticResource Dev_Menu_Upload}"
                                                                  x:Name="UploadMainMenu"
                                                                  ItemsSource="{Binding Source={StaticResource RootContext}, Path=Files}"
                                                                  ItemContainerStyle="{StaticResource DeviceUploadMenuItemStyle}"
                                                                  Style="{StaticResource DeviceUploadMainMenuItemStyle}">
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Canvas Grid.Row="1" >
                                    <Canvas.Style>
                                        <Style>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=boxDevicesList, Path=SelectedItems.Count}" Value="0">
                                                    <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <StackPanel DataContext="{Binding ElementName=boxDevicesList, Path=SelectedItem}" Orientation="Vertical">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82"></ColumnDefinition>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"></RowDefinition>
                                                <RowDefinition Height="{Binding ElementName=UploadProgressBar, Path=Height}"></RowDefinition>
                                                <RowDefinition Height="16"></RowDefinition>
                                                <RowDefinition Height="16"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <StackPanel x:Name="descriptionsStack" Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                                <TextBlock Text="{StaticResource Dev_Props_Name}" Margin="0,2,0,0" />
                                                <TextBlock Text="{StaticResource Dev_Props_Power}" />
                                                <TextBlock Text="{StaticResource Dev_Props_Length}" />
                                                <TextBlock Text="{StaticResource Dev_Props_Status}" />
                                            </StackPanel>
                                            <StackPanel x:Name="valuesStack" Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                                                <TextBlock Text="{Binding FullName}" Margin="0,2,0,0"/>
                                                <ProgressBar Value="{Binding EnergyLevel}" Margin="0,3,0,0" Style="{StaticResource ProgressBarStyle}"/>
                                                <TextBlock Text="{Binding LedsTotal}" />
                                                <TextBlock Text="{Binding Status}" />
                                            </StackPanel>
                                            <ProgressBar 
                                                x:Name="UploadProgressBar"
                                                Value="{Binding Progress}" 
                                                Minimum="{Binding ProgressMin}" 
                                                Maximum="{Binding ProgressMax}" 
                                                Style="{StaticResource OperationProgressBarStyle}"
                                                Grid.ColumnSpan="2"
                                                Grid.Row="1"
                                                Margin="0,2,0,0" />
                                            <TextBlock Text="{StaticResource Dev_Props_UpdateNeeded}" Foreground="#d0d010" Margin="0,2,0,0" Visibility="{Binding UpdateNeeded}" Grid.Row="2" Grid.ColumnSpan="2"/>
                                            <Button Style="{StaticResource LinkButton}" Content="{StaticResource Dev_Props_Update}" Command="{Binding AutoUpdateCommand}" Visibility="{Binding UpdateNeeded}" Grid.Row="3" Margin="8,0,0,0"></Button>
                                            <Button Style="{StaticResource LinkButton}" Content="{StaticResource Dev_Props_Postpone}" Command="{Binding UpdatePostponeCommand}" Visibility="{Binding UpdateNeeded}" Grid.Row="3" Grid.Column="1"></Button>
                                        </Grid>
                                    </StackPanel>
                                </Canvas>
                            </Grid>
                        </DataTemplate>
                    </local:PanesTemplateSelector.DevicesViewTemplate>
                    <local:PanesTemplateSelector.ProjectsViewTemplate>
                        <DataTemplate>
                            <ListBox x:Name="boxProjectsList" MinWidth="120" MinHeight="120" ItemsSource="{Binding Files}"></ListBox>
                        </DataTemplate>
                    </local:PanesTemplateSelector.ProjectsViewTemplate>
                    <local:PanesTemplateSelector.ImagesViewTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Opacity="50" Margin="1,0,0,-2" Background="#ffffff">
                                    <Button Style="{StaticResource BlueLinkButton}" Content="Создать" Click="Create_Button_Click" Margin="4,0,4,0"></Button>
                                    <Button Style="{StaticResource BlueLinkButton}" Content="Изменить" Margin="4,0,4,0"></Button>
                                    <Button Style="{StaticResource BlueLinkButton}" Content="Удалить" Click="Delete_Button_Click" Margin="4,0,4,0"></Button>
                                    <Button Style="{StaticResource BlueLinkButton}" Content="Обновить" Click="Resfresh_Button_Click" Margin="10,0,4,0"></Button>
                                </StackPanel>
                                <ListView Grid.Row="1" x:Name="boxThumbnails" 
                                                      SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
                                                      SelectionMode="Extended" 
                                                      AllowDrop="True"
                                                      KeyDown="boxThumbnails_KeyDown"
                                                      Drop="boxThumbnails_Drop"
                                                      DragEnter="boxThumbnails_DragEnter"
                                                      DragOver="boxThumbnails_DragOver"
                                                      dd:DragDropHelper.IsDragSource="True" 
                                                      ItemsSource="{Binding ImagesCollection, Mode=OneWay}">
                                    <ListView.View>
                                        <l:ImageView />
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </DataTemplate>
                    </local:PanesTemplateSelector.ImagesViewTemplate>
                </local:PanesTemplateSelector>
            </avalonDock:DockingManager.LayoutItemTemplateSelector>
            <avalonDock:DockingManager.LayoutItemContainerStyleSelector>
                <local:PanesStyleSelector>
                    <local:PanesStyleSelector.ToolStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="Visibility" Value="{Binding Model.IsVisible, Mode=TwoWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </local:PanesStyleSelector.ToolStyle>
                    <local:PanesStyleSelector.FileStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.FileName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Setter Property="ToolTip" Value="{Binding Model.FilePath}"/>
                            <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </local:PanesStyleSelector.FileStyle>
                </local:PanesStyleSelector>
            </avalonDock:DockingManager.LayoutItemContainerStyleSelector>
            
            <avalonDock:LayoutRoot>

                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        <avalonDock:LayoutAnchorablePane TargetContentID="ProjectsTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane TargetContentID="DevicesTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>

                    <avalonDock:LayoutPanel Orientation="Vertical" >
                        
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane />
                        </avalonDock:LayoutDocumentPaneGroup>

                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="100" DockHeight="120" DockMinHeight="80" DockMinWidth="80">
                            <avalonDock:LayoutAnchorablePane TargetContentID="ImagesTool" />
                        </avalonDock:LayoutAnchorablePaneGroup>
                        
                    </avalonDock:LayoutPanel>
                    
                </avalonDock:LayoutPanel>

            </avalonDock:LayoutRoot>
            
        </avalonDock:DockingManager>

        <StatusBar Grid.Row="2">
            <StatusBarItem Content="Pixel Tuner" Margin="2,0,0,2"/>
            <StatusBarItem Content="{Binding AssemblyVersion}" Margin="0,0,2,2"/>
            <StatusBarItem >
                <Button Style="{StaticResource BlueLinkButton}" Content="{StaticResource Dev_Props_Update}" Command="{Binding UpdateCommand}" Visibility="{Binding UpdatesAvailable}" Margin="8,-4,0,0"></Button>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}"></KeyBinding>
    </Window.InputBindings>
</Window>
