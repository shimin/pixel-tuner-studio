<Window x:Class="PixelTuner.MainWindow"
        x:Name="MainWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelTuner" Height="525" Width="960" WindowStyle="SingleBorderWindow" 
        Icon="/PixelTuner;component/Images/PixelTuner.ico"
        Style="{DynamicResource WindowStyle}"
        
        xmlns:avalonDock="http://avalondock.codeplex.com"
        xmlns:tt="clr-namespace:Core;assembly=Core"
        xmlns:l="clr-namespace:PixelTuner.ListViewStyle;assembly=Appearance"
        xmlns:dd="clr-namespace:Core.DragDrop;assembly=Core"
        xmlns:local="clr-namespace:PixelTuner"
        xmlns:service="clr-namespace:PixelTuner.Service"

        Activated="MainWnd_Activated"
        Loaded="Window_Loaded" Closing="Window_Closing">
    
<Window.Resources>
        <Color R="255"
               G="255"
               B="255"
               A="180"
               x:Key="BgColor" />
            <SolidColorBrush Color="{StaticResource BgColor}" x:Key="BgBrush" />
        <SolidColorBrush Color="#ffffff" x:Key="TextBrush" />
        <BooleanToVisibilityConverter x:Key="OldschoolVisibilityConverter" />
        <Style TargetType="{x:Type tt:TimeLineItemControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type tt:TimeLineItemControl}">
                        <Grid>
                            <Border Background="Blue"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_ContentHostPART_ContentHost" />
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_LeftIndicator">
                                <ContentPresenter.Content>
                                    <Button />
                                </ContentPresenter.Content>

                            </ContentPresenter>
                            <ContentPresenter HorizontalAlignment="Right"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_RightIndicator">
                                <ContentPresenter.Content>
                                    <Button />
                                </ContentPresenter.Content>

                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonDownStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border MinWidth="6" MinHeight="4">
                            <Image x:Name="DownImage" Source="/PixelTuner;component/Images/_grey_Arrow-Down.png"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-DownLight.png" TargetName="DownImage"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-DownDisabled.png" TargetName="DownImage"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonUpStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border MinWidth="6" MinHeight="4">
                            <Image x:Name="UpImage" Source="/PixelTuner;component/Images/_grey_Arrow-Up.png"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-UpLight.png" TargetName="UpImage"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-UpDisabled.png" TargetName="UpImage"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonDeleteLineStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Width="16" Height="14">
                            <Image x:Name="UpImage" Source="/PixelTuner;component/Images/red_cross.png"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/red_crossLight.png" TargetName="UpImage"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/red_crossDisabled.png" TargetName="UpImage"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="MinHeight" Value="12"></Setter>
            <Setter Property="Margin" Value="0,0,0,2"></Setter>
        </Style>
        <Style x:Key="OperationProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="MinHeight" Value="12"></Setter>
            <Setter Property="Margin" Value="0,0,0,2"></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusRaw}" Value="2">
                    <!--<MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding StatusRaw}" Value="2"></Condition>
                        <Condition Binding="{Binding StatusRaw}" Value="3"></Condition>
                        <Condition Binding="{Binding StatusRaw}" Value="4"></Condition>
                    </MultiDataTrigger.Conditions>-->
                    <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusRaw}" Value="3">
                    <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusRaw}" Value="4">
                    <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Name="DeviceUploadMainMenuItemStyle" x:Key="DeviceUploadMainMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={StaticResource RootContext}, Path=Files.Count}" Value="0">
                    <Setter Property="IsEnabled" Value="false"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Name="DeviceUploadMenuItemStyle" x:Key="DeviceUploadMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.UploadCommand, 
                RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}"></Setter>
            <Setter Property="CommandParameter" Value="{Binding .}"></Setter>
        </Style>
        <DataTemplate  DataType="{x:Type l:ThumbnailFileItem}">
            <Border BorderThickness="1"
                    BorderBrush="Blue"
                    CornerRadius="3"
                    Height="30">
                <TextBlock Text="{Binding Path=Name}" />
            </Border>
        </DataTemplate>
        <DataTemplate  DataType="{x:Type l:ThumbnailFileItem}"
                       x:Key="ItemTemplateProperty">
            <Border BorderThickness="1"
                    BorderBrush="White"
                    CornerRadius="3"
                    Margin="0,10,0,10"
                    Height="80"
                    Background="{StaticResource BgBrush}">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="SizeChanged">
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel Orientation="Vertical">
                    <!--<TextBlock Text="{Binding Path=Name}" /> -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Path=Start}" />
                        <Button Grid.Column="1" Margin="0,2,0,0" Command="{Binding DisposeMe}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Width="16" Height="14">
                                        <Image x:Name="RemoveBtnImage" Source="/PixelTuner;component/Images/PinClose_Dark.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter Property="Source" Value="/PixelTuner;component/Images/PinClose.png" TargetName="RemoveBtnImage"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <Border Height="44" MinWidth="200">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding FullName}"
                                        AlignmentX="Left"
                                        Stretch="Uniform" 
                                        TileMode="Tile"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding Path=End}" />
                    <!--<TextBlock Text="{Binding Path=Duration}" /> -->
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate  DataType="{x:Type local:TimeLineViewModel}"
                       x:Key="TimeLineLayoutTemplate">
            <ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Background="#4a4a4a">
                        <Button Height="14" Margin="4,3,2,0" Style="{StaticResource ButtonUpStyle}" Command="{Binding MoveUp}"></Button>
                        <Button Height="14" Margin="4,0,2,1" Style="{StaticResource ButtonDownStyle}" Command="{Binding MoveDown}"></Button>
                        <Button Height="16" Margin="4,1,2,1" Style="{StaticResource ButtonDeleteLineStyle}" Command="{Binding DeleteLine}"></Button>
                    </StackPanel>
                    <tt:TimeLineControl 
                        Grid.Column="1" 
                        Grid.RowSpan="3" 
                        Height="100"
                        Items="{Binding Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemTemplate="{StaticResource ItemTemplateProperty}"
                        ViewLevel="Seconds"
                        HorizontalAlignment="Left"
                        x:Name="TimeLine"
                        StartDate="{Binding Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        UnitSize="{Binding ElementName=Slider_Scale, Path=Value}"
                        MinimumUnitWidth="20"
                        Background="{Binding Background}"
                        DrawTimeGrid="False"
                        MinWidth="740"
                        DefaultTimeInterval="10"
                        SynchedWithSiblings="True" />
                </Grid>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate  DataType="{x:Type local:FileViewModel}"
                       x:Key="FileLayoutTemplate">
                        <ItemsControl Grid.Row="1" 
                                      ItemTemplate="{StaticResource TimeLineLayoutTemplate}"
                                      ItemsSource="{Binding Path=TimeLines, Mode=TwoWay}" />
        </DataTemplate>
        <local:ActiveDocumentConverter x:Key="ActiveDocumentConverter"/>
        <avalonDock:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        
        <Menu Padding="0">
            <MenuItem Header="{StaticResource Menu_File}">
                <MenuItem Header="{StaticResource Menu_File_New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{StaticResource Menu_File_Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="{StaticResource Menu_File_Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="{StaticResource Menu_File_SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="{StaticResource Menu_File_Close}" Command="{Binding CloseCommand}" InputGestureText="Ctrl+W"/>
                <MenuItem Header="{StaticResource Menu_File_Exit}" Click="ExitApplication"/>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Window}">
                <MenuItem Header="{StaticResource Menu_Window_Projects}" IsCheckable="True" IsChecked="{Binding ProjectsModel.IsVisible, Mode=TwoWay}"/>
                <MenuItem Header="{StaticResource Menu_Window_Devices}" IsCheckable="True" IsChecked="{Binding DevicesModel.IsVisible, Mode=TwoWay}"/>
            </MenuItem>
        </Menu>

        <avalonDock:DockingManager Name="dockManager" 
                                   DocumentsSource="{Binding Files}"
                                   AnchorablesSource="{Binding Tools}"
                                   ActiveContent="{Binding ActiveDocument, Mode=TwoWay, Converter={StaticResource ActiveDocumentConverter}}"
                                   Grid.Row="1">
            <avalonDock:DockingManager.Theme>
                <avalonDock:DefaultTheme/>
            </avalonDock:DockingManager.Theme>

            <avalonDock:DockingManager.LayoutItemTemplateSelector>
                <local:PanesTemplateSelector>
                    <local:PanesTemplateSelector.FileViewTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="0"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="NewBtn" Grid.Row="0" Grid.Column="0" Margin="4,0,0,2" 
                                        Content="{StaticResource Doc_Btn_AddLine}" 
                                        Command="{Binding AddLine}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="16,4,4,0" Foreground="{StaticResource TextBrush}" Text="{StaticResource Doc_Lbl_Scale}"/>
                                <Slider Grid.Row="0" Grid.Column="2" x:Name="Slider_Scale" Margin="2" Minimum="1" Maximum="60" Value="{Binding UnitSize}"/>
                                <TextBlock Grid.Column="3" Margin="16,4,4,0" Foreground="{StaticResource TextBrush}" Text="{StaticResource Doc_Lbl_Height}" />
                                <local:NumericUpDownControl 
                                    Grid.Column="4" 
                                    Margin="4,2,2,0" 
                                    MaxValue="100"
                                    MinValue="5"
                                    Step="5"
                                    IsEnabled="{Binding Path=Parent.DataContext.LineHeightChangingAvailable, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    Value="{Binding Path=Parent.DataContext.LineHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <ScrollViewer Grid.Row="1"
                                                Grid.ColumnSpan="6"
                                                Grid.RowSpan="2"
                                                HorizontalAlignment="Stretch"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalAlignment="Stretch">
                                    <StackPanel x:Name="timelineStackPanel" Orientation="Vertical">
                                        <ItemsControl Grid.Row="1" 
                                                        ItemTemplate="{StaticResource TimeLineLayoutTemplate}"
                                                        ItemsSource="{Binding Path=TimeLines, Mode=TwoWay}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </local:PanesTemplateSelector.FileViewTemplate>
                    <local:PanesTemplateSelector.DevicesViewTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="80"></RowDefinition>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="boxDevicesList" MinWidth="120" MinHeight="120"
                                         Grid.Row="0"
                                         ItemsSource="{Binding Source={x:Static Member=service:DeviceHelper.Devices}, UpdateSourceTrigger=PropertyChanged}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Single"
                                         >
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.DataContext}">
                                                        <MenuItem Header="{StaticResource Dev_Menu_RefreshBrain}" Command="{Binding UploadFirmwareCommand}"></MenuItem>
                                                        <MenuItem Header="{StaticResource Dev_Menu_Upload}"
                                                                  x:Name="UploadMainMenu"
                                                                  ItemsSource="{Binding Source={StaticResource RootContext}, Path=Files}"
                                                                  ItemContainerStyle="{StaticResource DeviceUploadMenuItemStyle}"
                                                                  Style="{StaticResource DeviceUploadMainMenuItemStyle}">
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Canvas Grid.Row="1" >
                                    <Canvas.Style>
                                        <Style>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=boxDevicesList, Path=SelectedItems.Count}" Value="0">
                                                    <Setter Property="Canvas.Visibility" Value="Collapsed"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <StackPanel DataContext="{Binding ElementName=boxDevicesList, Path=SelectedItem}" Orientation="Vertical">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"></ColumnDefinition>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel x:Name="descriptionsStack" Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                                <TextBlock Text="{StaticResource Dev_Props_Name}" />
                                                <TextBlock Text="{StaticResource Dev_Props_Memory}" />
                                                <TextBlock Text="{StaticResource Dev_Props_Power}" />
                                                <TextBlock Text="{StaticResource Dev_Props_Status}" Margin="0,7,0,2" />
                                            </StackPanel>
                                            <StackPanel x:Name="valuesStack" Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                                                <TextBlock Text="{Binding Name}" Margin="0,0,0,2"/>
                                                <ProgressBar Value="{Binding MemoryRate}" Style="{StaticResource ProgressBarStyle}" />
                                                <ProgressBar Value="{Binding EnergyLevel}" Style="{StaticResource ProgressBarStyle}" />
                                                <TextBlock Text="{Binding Status}" Margin="0,4,0,2"/>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar 
                                            Value="{Binding Progress}" 
                                            Minimum="{Binding ProgressMin}" 
                                            Maximum="{Binding ProgressMax}" 
                                            Style="{StaticResource OperationProgressBarStyle}"/>
                                    </StackPanel>
                                </Canvas>
                            </Grid>
                        </DataTemplate>
                    </local:PanesTemplateSelector.DevicesViewTemplate>
                    <local:PanesTemplateSelector.ProjectsViewTemplate>
                        <DataTemplate>
                            <ListBox x:Name="boxProjectsList" MinWidth="120" MinHeight="120" ItemsSource="{Binding Files}"></ListBox>
                        </DataTemplate>
                    </local:PanesTemplateSelector.ProjectsViewTemplate>
                </local:PanesTemplateSelector>
            </avalonDock:DockingManager.LayoutItemTemplateSelector>
            <avalonDock:DockingManager.LayoutItemContainerStyleSelector>
                <local:PanesStyleSelector>
                    <local:PanesStyleSelector.ToolStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="Visibility" Value="{Binding Model.IsVisible, Mode=TwoWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </local:PanesStyleSelector.ToolStyle>
                    <local:PanesStyleSelector.FileStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.FileName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Setter Property="ToolTip" Value="{Binding Model.FilePath}"/>
                            <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </local:PanesStyleSelector.FileStyle>
                </local:PanesStyleSelector>
            </avalonDock:DockingManager.LayoutItemContainerStyleSelector>
            
            <avalonDock:LayoutRoot>

                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        <avalonDock:LayoutAnchorablePane TargetContentID="ProjectsTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane TargetContentID="DevicesTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>

                    <avalonDock:LayoutPanel Orientation="Vertical" >
                        
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane />
                        </avalonDock:LayoutDocumentPaneGroup>

                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="100" DockHeight="120" DockMinHeight="80" DockMinWidth="80">
                            <avalonDock:LayoutAnchorablePane>
                                <avalonDock:LayoutAnchorable x:Name="boxImagesWindow" Title="{StaticResource Menu_Window_Images}">
                                        <ListView x:Name="boxThumbnails" 
                                                  SelectionMode="Extended" 
                                                  dd:DragDropHelper.IsDragSource="True" 
                                                  ItemsSource="{Binding ImagesCollection}">
                                                <ListView.View>
                                                    <l:ImageView />
                                                </ListView.View>
                                        </ListView>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>
                        
                    </avalonDock:LayoutPanel>
                    
                </avalonDock:LayoutPanel>

            </avalonDock:LayoutRoot>
            
        </avalonDock:DockingManager>

        <StatusBar Grid.Row="2">
            <StatusBarItem Content="Pixel Tuner 2.0"/>
        </StatusBar>
    </Grid>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}"></KeyBinding>
    </Window.InputBindings>
</Window>
