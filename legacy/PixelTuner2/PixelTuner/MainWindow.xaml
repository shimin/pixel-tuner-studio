<Window x:Class="PixelTuner.MainWindow"
        x:Name="MainWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelTuner" MinHeight="525" MinWidth="960" WindowStyle="SingleBorderWindow" 
        Icon="/PixelTuner;component/Files/PixelTuner.ico"
        
        xmlns:avalonDock="http://schemas.xceed.com/wpf/xaml/avalondock"
        xmlns:ct="clr-namespace:Common.Controls;assembly=Common"
        xmlns:dd="clr-namespace:Common.DragDrop;assembly=Common"
        xmlns:tlw="clr-namespace:PixelTuner.Controls.ThumbListView"
        
        xmlns:pt="clr-namespace:PixelTuner"
        xmlns:vm="clr-namespace:PixelTuner.ViewModel"
        xmlns:cv="clr-namespace:PixelTuner.Converters"
        xmlns:sl="clr-namespace:PixelTuner.Selectors"

        Activated="MainWnd_Activated"
        Loaded="Window_Loaded" Closing="Window_Closing" Unloaded="MainWnd_Unloaded">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PixelTuner;component/Styles/DevicesLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/FileLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/ProjectPlayerLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/ImagesLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/GradientsLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/EffectsLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/VideosLayoutTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/CanvasTemplate.xaml" />
                <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        
            <cv:ActiveDocumentConverter x:Key="ActiveDocumentConverter"/>
        
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        
        <Menu Padding="0">
            <MenuItem Header="{StaticResource Menu_File}">
                <MenuItem Header="{StaticResource Menu_File_New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{StaticResource Menu_File_Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="{StaticResource Menu_File_Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="{StaticResource Menu_File_Export}" Command="{Binding ExportCommand}" Visibility="{Binding ExportCommandVisibility}" />
                <MenuItem Header="{StaticResource Menu_File_SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="{StaticResource Menu_File_Close}" Command="{Binding CloseCommand}" InputGestureText="Ctrl+W"/>
                <ct:RecentFileList x:Name="RecentFileList" MaxNumberOfFiles="4"/>
                <MenuItem Header="{StaticResource Menu_File_Exit}" Click="ExitApplication"/>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Window}">
                <MenuItem Header="{StaticResource Menu_Window_Window}">
                    <MenuItem Header="{StaticResource Menu_Window_ProjectPlayer}" IsCheckable="True" IsChecked="{Binding ProjectPlayerModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <MenuItem Header="{StaticResource Menu_Window_Projects}" IsCheckable="True" IsChecked="{Binding ProjectsModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <MenuItem Header="{StaticResource Menu_Window_Devices}" IsCheckable="True" IsChecked="{Binding DevicesModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <MenuItem Header="{StaticResource Menu_Window_Canvas}" IsCheckable="True" IsChecked="{Binding CanvasModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <MenuItem Header="{StaticResource Menu_Window_Images}" IsCheckable="True" IsChecked="{Binding ImagesModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <MenuItem Header="{StaticResource Menu_Window_Gradients}" IsCheckable="True" IsChecked="{Binding GradientsModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <MenuItem Header="{StaticResource Menu_Window_Videos}" IsCheckable="True" IsChecked="{Binding VideosModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    <MenuItem Header="{StaticResource Menu_Window_Effects}" IsCheckable="True" IsChecked="{Binding EffectsModel.IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Settings}">
                <MenuItem Header="{StaticResource Menu_Settings_Artnet_Window}" Command="{Binding ArtnetCommand}"/>
                <MenuItem Header="{StaticResource Menu_Settings_Defaults}" Command="{Binding AdjustDefaultsCommand}" InputGestureText="Alt+P"/>
            </MenuItem>
        </Menu>
        
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <ComboBox ItemsSource="{Binding AnchorStepCollection}" DisplayMemberPath="Value" SelectedValuePath="Key" MinWidth="64" SelectedValue="{Binding AnchorStep}"></ComboBox>
                <Button Name="boxSwitchInsertMode" Padding="0" Grid.Row="1" Height="20" Width="Auto" Click="boxSwitchInsertMode_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Margin="-1,-1,0,0" Padding="0" Height="16" Width="24" >
                                <Image Name="boxInsertModeIcon" Stretch="Fill" Margin="0">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Source" Value="/PixelTuner;component/Images/moveTheRest.png"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CutNextItems}" Value="true">
                                                    <Setter Property="Source" Value="/PixelTuner;component/Images/cutTheRest.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </ToolBar>
        </ToolBarTray>
        
        <avalonDock:DockingManager Name="dockManager" 
                                   DocumentsSource="{Binding Files}"
                                   AnchorablesSource="{Binding Tools}"
                                   ActiveContent="{Binding ActiveDocument, Mode=TwoWay, Converter={StaticResource ActiveDocumentConverter}}"
                                   Grid.Row="2">
            <avalonDock:DockingManager.Theme>
                <avalonDock:DefaultTheme/>
            </avalonDock:DockingManager.Theme>

            <avalonDock:DockingManager.LayoutItemTemplateSelector>
                <sl:PanesTemplateSelector 
                    CanvasViewTemplate="{StaticResource CanvasTemplate}"
                    DevicesViewTemplate="{StaticResource DevicesLayoutTemplate}"
                    ImagesViewTemplate="{StaticResource ImagesLayoutTemplate}"
                    FileViewTemplate="{StaticResource FileLayoutTemplate}"
                    ProjectPlayerViewTemplate="{StaticResource ProjectPlayerLayoutTemplate}"
                    GradientsViewTemplate="{StaticResource GradientsLayoutTemplate}"
                    EffectsViewTemplate="{StaticResource EffectsLayoutTemplate}"
                    VideosViewTemplate="{StaticResource VideosLayoutTemplate}">
                </sl:PanesTemplateSelector>
            </avalonDock:DockingManager.LayoutItemTemplateSelector>

            <avalonDock:DockingManager.LayoutItemContainerStyleSelector>
                <sl:PanesStyleSelector>
                    <sl:PanesStyleSelector.ToolStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="Visibility" Value="{Binding Model.IsVisible, Mode=TwoWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </sl:PanesStyleSelector.ToolStyle>
                    <sl:PanesStyleSelector.FileStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.FileName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Setter Property="ToolTip" Value="{Binding Model.FilePath}"/>
                            <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </sl:PanesStyleSelector.FileStyle>
                </sl:PanesStyleSelector>
            </avalonDock:DockingManager.LayoutItemContainerStyleSelector>

            <avalonDock:DockingManager.LayoutUpdateStrategy>
                <pt:LayoutInitializer/>
            </avalonDock:DockingManager.LayoutUpdateStrategy>
            
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        <avalonDock:LayoutAnchorablePane Name="ProjectsTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120"/>
                        <avalonDock:LayoutAnchorablePane Name="DevicesTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120"/>
                        <avalonDock:LayoutAnchorablePane Name="ProjectPlayerTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120"/>
                        <avalonDock:LayoutAnchorablePane Name="CanvasTool" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120"/>
                    </avalonDock:LayoutAnchorablePaneGroup>
                    <avalonDock:LayoutPanel Orientation="Vertical" >
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane />
                        </avalonDock:LayoutDocumentPaneGroup>
                        <avalonDock:LayoutAnchorablePaneGroup DockHeight="120" DockMinHeight="80" DockMinWidth="80">
                            <avalonDock:LayoutAnchorablePane Name="ImagesTool" />
                            <avalonDock:LayoutAnchorablePane Name="EffectsTool" />
                            <avalonDock:LayoutAnchorablePane Name="GradientsTool" />
                            <avalonDock:LayoutAnchorablePane Name="VideosTool" />
                        </avalonDock:LayoutAnchorablePaneGroup>
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        
        </avalonDock:DockingManager>

        <StatusBar Grid.Row="3">
            <StatusBarItem Content="Pixel Tuner" Margin="2,0,0,2"/>
            <StatusBarItem Content="{Binding AssemblyVersion}" Margin="0,0,2,2"/>
            <StatusBarItem >
                <Button Style="{StaticResource BlueLinkButton}" Content="{StaticResource Dev_Props_Update}" Command="{Binding UpdateCommand}" Visibility="{Binding UpdatesAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Margin="8,-4,0,0"></Button>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"></KeyBinding>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}"></KeyBinding>
        <KeyBinding Gesture="Alt+P" Command="{Binding AdjustDefaultsCommand}"></KeyBinding>
    </Window.InputBindings>
</Window>
