<Window x:Class="PixelTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelTuner" Height="484" Width="960" WindowStyle="SingleBorderWindow" 
        
        xmlns:avalonDock="http://avalondock.codeplex.com"
        xmlns:tt="clr-namespace:TimeLineTool;assembly=TimeLineTool"
        xmlns:l="clr-namespace:PixelTuner.ListViewStyle;assembly=ListViewStyle"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        xmlns:local="clr-namespace:PixelTuner"
        
        Loaded="Window_Loaded" Closing="Window_Closing">
    
<Window.Resources>
        <Color R="255"
               G="255"
               B="255"
               A="180"
               x:Key="BgColor" />
        <SolidColorBrush Color="{StaticResource BgColor}"
                         x:Key="BgBrush" />
        <Style TargetType="{x:Type tt:TimeLineItemControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type tt:TimeLineItemControl}">
                        <Grid>
                            <Border Background="Blue"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_ContentHostPART_ContentHost" />
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_LeftIndicator">
                                <ContentPresenter.Content>
                                    <Button />
                                </ContentPresenter.Content>

                            </ContentPresenter>
                            <ContentPresenter HorizontalAlignment="Right"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_RightIndicator">
                                <ContentPresenter.Content>
                                    <Button />
                                </ContentPresenter.Content>

                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DragAdorner">
            <Border Background="Silver" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Margin="1">
                <StackPanel Orientation="Horizontal">
                    <Image Source="./icon.png" Width="16" Margin="0,0,2,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" Margin="0,0,2,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate  DataType="{x:Type l:ThumbnailFileItem}">
            <Border BorderThickness="1"
                    BorderBrush="Blue"
                    CornerRadius="3"
                    Height="30">
                <TextBlock Text="{Binding Path=Name}" />
            </Border>
        </DataTemplate>
        <DataTemplate  DataType="{x:Type l:ThumbnailFileItem}"
                       x:Key="UsedTemplateProperty">
            <Border BorderThickness="1"
                    BorderBrush="White"
                    CornerRadius="3"
                    Margin="0,10,0,10"
                    Height="60"
                    Background="{StaticResource BgBrush}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Path=Name}" />
                    <TextBlock Text="{Binding Path=StartTime}" />
                    <TextBlock Text="{Binding Path=EndTime}" />
                    <TextBlock Text="{Binding Path=Duration}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <local:ActiveTimeLineConverter x:Key="ActiveTimeLineConverter"/>
        <DataTemplate  DataType="{x:Type local:TimeLineViewModel}"
                       x:Key="TimeLineLayoutTemplate">
            <Border BorderThickness="1"
                    BorderBrush="#40ffffff">
                <StackPanel Orientation="Vertical">
                    <tt:TimeLineControl Height="80"
                        Items="{Binding Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemTemplate="{StaticResource UsedTemplateProperty}"
                        HorizontalAlignment="Left"
                        x:Name="TimeLine"
                        StartDate="{Binding Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        UnitSize="{Binding ElementName=Slider_Scale, Path=Value}"
                        MinimumUnitWidth="20"
                        Background="#4A4A4A"
                        DrawTimeGrid="False"
                        MinWidth="450"
                        SynchedWithSiblings="False" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <local:ActiveDocumentConverter x:Key="ActiveDocumentConverter"/>
        <avalonDock:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        
        <Menu Padding="0">
            <MenuItem Header="{StaticResource Menu_File}">
                <MenuItem Header="{StaticResource Menu_File_New}" Command="{Binding NewCommand}"/>
                <MenuItem Header="{StaticResource Menu_File_Exit}" Click="ExitApplication"/>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Window}">
                <MenuItem Header="{StaticResource Menu_Window_Projects}" Click="ShowProjectList"/>
                <MenuItem Header="{StaticResource Menu_Window_Devices}" Click="ShowDeviceList"/>
            </MenuItem>
        </Menu>

        <avalonDock:DockingManager Name="dockManager" 
                                   DocumentsSource="{Binding Files}"
                                   AnchorablesSource="{Binding Tools}"
                                   ActiveContent="{Binding ActiveDocument, Mode=TwoWay, Converter={StaticResource ActiveDocumentConverter}}"
                                   Grid.Row="1">
            <avalonDock:DockingManager.Theme>
                <avalonDock:DefaultTheme/>
            </avalonDock:DockingManager.Theme>
            <avalonDock:DockingManager.LayoutItemTemplateSelector>
                <local:PanesTemplateSelector>
                    <local:PanesTemplateSelector.FileViewTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="320"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel FlowDirection="LeftToRight">

                                </DockPanel>
                                <ItemsControl Grid.Row="1" ItemTemplate="{StaticResource TimeLineLayoutTemplate}"
                                              ItemsSource="{Binding Path=TimeLines, Mode=TwoWay}">
                                </ItemsControl>
                                <Slider x:Name="Slider_Scale" Margin="8" Minimum="1" Maximum="10" Value="6"
                                                Grid.Row="2" ValueChanged="Slider_Scale_ValueChanged" />
                                <!--<ListBox x:Name="ListSrc" Grid.Row="2" dd:DragDrop.IsDragSource="True" /> -->
                            </Grid>
                        </DataTemplate>
                    </local:PanesTemplateSelector.FileViewTemplate>
                </local:PanesTemplateSelector>
            </avalonDock:DockingManager.LayoutItemTemplateSelector>
            <avalonDock:DockingManager.LayoutItemContainerStyleSelector>
                <local:PanesStyleSelector>
                    <local:PanesStyleSelector.ToolStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="Visibility" Value="{Binding Model.IsVisible, Mode=TwoWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </local:PanesStyleSelector.ToolStyle>
                    <local:PanesStyleSelector.FileStyle>
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}"/>
                            <Setter Property="ToolTip" Value="{Binding Model.FilePath}"/>
                            <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}"/>
                            <Setter Property="IconSource" Value="{Binding Model.IconSource}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                        </Style>
                    </local:PanesStyleSelector.FileStyle>
                </local:PanesStyleSelector>
            </avalonDock:DockingManager.LayoutItemContainerStyleSelector>
            
            <avalonDock:LayoutRoot>

                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                        <avalonDock:LayoutAnchorablePane DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                            <avalonDock:LayoutAnchorable x:Name="boxProjectsWindow" Title="{StaticResource Menu_Window_Projects}" IsSelected="True">
                                <ListBox x:Name="boxProjectsList" MinWidth="120" MinHeight="120"></ListBox>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane DockWidth="160" DockHeight="120" DockMinHeight="100" DockMinWidth="120">
                            <avalonDock:LayoutAnchorable x:Name="boxDevicesWindow" Title="{StaticResource Menu_Window_Devices}" IsSelected="True" >
                                <ListBox x:Name="boxDevicesList" MinWidth="120" MinHeight="120"></ListBox>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>

                    <avalonDock:LayoutPanel Orientation="Vertical" >
                        
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane />
                        </avalonDock:LayoutDocumentPaneGroup>

                        <avalonDock:LayoutAnchorablePaneGroup DockWidth="100" DockHeight="100" DockMinHeight="80" DockMinWidth="80">
                            <avalonDock:LayoutAnchorablePane>
                                <avalonDock:LayoutAnchorable x:Name="boxImagesWindow" 
                                                             Title="{StaticResource Menu_Window_Images}">
                                    <ListView x:Name="boxThumbnails" 
                                              SelectionMode="Extended"
                                              dd:DragDrop.IsDragSource="True" 
                                              dd:DragDrop.DragAdornerTemplate="{StaticResource DragAdorner}">
                                                <ListView.View>
                                                    <l:ImageView />
                                                </ListView.View>
                                                <ListView.ItemsSource>
                                                    <l:FileCollection />
                                                </ListView.ItemsSource>
                                    </ListView>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>
                        
                    </avalonDock:LayoutPanel>
                    
                </avalonDock:LayoutPanel>

            </avalonDock:LayoutRoot>
            
        </avalonDock:DockingManager>

        <StatusBar Grid.Row="2">
            <StatusBarItem Content="Pixel Tuner 2.0"/>
        </StatusBar>
    </Grid>
</Window>
