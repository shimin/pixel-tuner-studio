<Window x:Class="PixelTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelTuner" Height="484" Width="898" WindowStyle="SingleBorderWindow" 
        
        xmlns:PixelTuner="clr-namespace:PixelTuner;assembly=PixelTuner"
        xmlns:avalonDock="http://avalondock.codeplex.com"
        xmlns:my="clr-namespace:TimeLineTool;assembly=TimeLineTool"
        
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        
        <Menu Padding="0">
            <MenuItem Header="{StaticResource Menu_File}">
                <MenuItem Header="{StaticResource Menu_File_New}" Click="NewDocument"/>
                <MenuItem Header="{StaticResource Menu_File_Exit}" Click="ExitApplication"/>
            </MenuItem>
            <MenuItem Header="{StaticResource Menu_Window}">
                <MenuItem Header="{StaticResource Menu_Window_Projects}" Click="ShowProjectList"/>
                <MenuItem Header="{StaticResource Menu_Window_Devices}" Click="ShowDeviceList"/>
            </MenuItem>
        </Menu>
        
        <avalonDock:DockingManager Name="dockManager" Grid.Row="1">
            <avalonDock:DockingManager.Theme>
                <avalonDock:VS2010Theme/>
            </avalonDock:DockingManager.Theme>

            <avalonDock:LayoutRoot PropertyChanged="LayoutRoot_PropertyChanged">
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutDocumentPaneGroup>
                        <avalonDock:LayoutDocumentPane x:Name="layoutPanel">
                            
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutDocumentPaneGroup>
                    <avalonDock:LayoutAnchorablePaneGroup DockWidth="260" DockHeight="260" DockMinHeight="240" DockMinWidth="240">
                        <avalonDock:LayoutAnchorablePane>
                            <avalonDock:LayoutAnchorable x:Name="boxProjectsWindow" Title="{StaticResource Menu_Window_Projects}" 
                                                         AutoHideMinHeight="240" AutoHideMinWidth="240" 
                                                         AutoHideHeight="260" AutoHideWidth="260">
                                <ListBox x:Name="boxProjectsList" MinWidth="240" MinHeight="240"></ListBox>
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="boxDevicesWindow" Title="{StaticResource Menu_Window_Devices}" 
                                                         AutoHideMinHeight="240" AutoHideMinWidth="240" 
                                                         AutoHideHeight="260" AutoHideWidth="260">
                                <ListBox x:Name="boxDevicesList" MinWidth="240" MinHeight="240"></ListBox>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>
                </avalonDock:LayoutPanel>
                
                
            </avalonDock:LayoutRoot>
            
        </avalonDock:DockingManager>

        <StatusBar Grid.Row="2">
            <StatusBarItem Content="Pixel Tuner 2.0"/>
        </StatusBar>
    </Grid>
</Window>
