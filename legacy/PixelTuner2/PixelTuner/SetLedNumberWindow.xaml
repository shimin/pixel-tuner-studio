<Window x:Class="PixelTuner.SetLedNumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelTuner"
        xmlns:xctk="clr-namespace:Toolkit;assembly=Toolkit"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="DarkGray"
        KeyDown="Window_KeyDown"
        Title="{StaticResource Markup_SetNumberTitle}" SizeToContent="WidthAndHeight" MinWidth="180">
    <StackPanel Margin="4">
        <TextBlock Name="boxHint" Margin="4" TextWrapping="Wrap" MaxWidth="220"/>
        <xctk:DecimalUpDown Name="boxValue" Minimum="1" Margin="4"></xctk:DecimalUpDown>
        <Button Content="OK" Margin="4" Click="Button_OnClick"></Button>
    </StackPanel>
</Window>
