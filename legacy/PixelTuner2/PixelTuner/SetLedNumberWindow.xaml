<Window x:Class="PixelTuner.SetLedNumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelTuner"
        xmlns:xctk="clr-namespace:Toolkit;assembly=Toolkit"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        Background="DarkGray"
        KeyDown="Window_KeyDown"
        Closing="Window_OnClosing"
        Title="SetLedNumberWindow" Height="90" Width="120">
    <StackPanel>
        <xctk:DecimalUpDown Name="boxValue" Minimum="0" Margin="4"></xctk:DecimalUpDown>
        <Button Content="OK" Margin="4" Click="Button_OnClick"></Button>
    </StackPanel>
</Window>
