<Application x:Class="PixelTuner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelTuner.ViewModel"
             DispatcherUnhandledException="Application_DispatcherUnhandledException"
             Startup="Application_Startup"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionaries/labels.ru-RU.xaml" />
                <ResourceDictionary Source="Dictionaries/labels.en-US.xaml" />
                <ResourceDictionary Source="Dictionaries/labels.de-DE.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RootViewModel x:Key="RootContext" x:Name="RootContext"></local:RootViewModel>
        </ResourceDictionary>
    </Application.Resources>
</Application>
