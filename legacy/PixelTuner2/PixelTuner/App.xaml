<Application x:Class="PixelTuner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelTuner"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionaries/labels.ru-RU.xaml" />
                <ResourceDictionary Source="Dictionaries/labels.en-US.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RootViewModel x:Key="RootContext" x:Name="RootContext"></local:RootViewModel>
            <!--<Style x:Key="WindowStyle" TargetType="{x:Type Window}">
                    <Setter Property="DataContext" Value="{StaticResource RootContext}"></Setter>
            </Style>-->
        </ResourceDictionary>
    </Application.Resources>
</Application>
