<Window x:Class="PixelTuner.WifiDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelTuner"
        mc:Ignorable="d"
        Background="#ff1a1a1a"
        Title="Wifi Devices" Height="500" Width="350" MinWidth="320">
    <Window.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="WifiDeviceTemplate">
                <Grid Margin="10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"></ColumnDefinition>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition Width="32"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="60"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="IP: " Foreground="White" Grid.Column="0" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Text="{Binding IPString}" Foreground="White" Grid.Column="1" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Text="Tag: " Foreground="White" Grid.Column="2" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Text="{Binding Tag}" Foreground="White" Grid.Column="3" VerticalAlignment="Center"></TextBlock>
                    <Rectangle Width="60" Height="26" Grid.Column="3" HorizontalAlignment="Right" ToolTip="{Binding LastAnswer}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#001a1a1a" Offset="0"></GradientStop>
                                <GradientStop Color="#ef1a1a1a" Offset="1"></GradientStop>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Orientation="Horizontal" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <Button Content="Play" Command="{Binding PlayCommand}" Margin="1,2"></Button>
                        <Button Content="Stop" Command="{Binding StopCommand}" Margin="1,2"></Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="38"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Foreground="White" Margin="8" VerticalAlignment="Center" Text="{Binding TotalDevices}"></TextBlock>
            <Button Grid.Column="1" Content="Refresh" Margin="8" Click="boxRefreshButton_Click"></Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource WifiDeviceTemplate}"/>
        </ScrollViewer>
        <Button Content="Close" Grid.Row="2" Width="80" HorizontalAlignment="Right" Margin="8" Click="ButtonBase_OnClick"></Button>
    </Grid>
</Window>
