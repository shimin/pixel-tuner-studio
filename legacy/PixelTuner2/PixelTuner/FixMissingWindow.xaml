<Window x:Class="PixelTuner.FixMissingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelTuner"
        mc:Ignorable="d"
        Title="PixelTuner 2" Height="238.358" Width="468" Background="#ff202020">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="22"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Не удается найти файл по указанному адресу:" Foreground="White"></TextBlock>
            <TextBlock Text="{Binding MissingPath}" Foreground="White" Margin="20,1" TextTrimming="CharacterEllipsis">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding MissingPath}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <TextBlock Text="Как с ним поступить:" Foreground="White"></TextBlock>
        </StackPanel>
        <StackPanel Orientation="Vertical" Margin="12,0" Grid.Row="1">
            <RadioButton Margin="5,2" Name="boxSetBaseDirectory" Content="Задать новое место всех файлов" Foreground="White" IsChecked="True"/>
            <RadioButton Margin="5,2" Name="boxSetOtherImageFromCollection" Content="Заменить другим файлом из коллекции" Foreground="White" />
            <RadioButton Margin="5,2" Name="boxSetOtherImageFromDrive" Content="Заменить другим файлом с диска" Foreground="White" />
            <RadioButton Margin="5,2" Name="boxSetFileToIgnore" Content="Игнорировать пропущенный файл и оставить незагруженным" Foreground="White" />
            <RadioButton Margin="5,2" Name="boxSetAllFilesToIgnore" Content="Игнорировать все пропущенные файлы и оставить незагруженными" Foreground="White" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0" HorizontalAlignment="Right" Width="170" Grid.Row="2">
            <Button Content="OK" Width="80" Margin="2,0" Click="boxOK_Click" IsDefault="True"></Button>
            <Button Content="Cancel" Width="80" Margin="2,0" Click="boxCancel_Click"></Button>
        </StackPanel>
    </Grid>
</Window>
