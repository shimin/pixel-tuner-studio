<Window x:Class="PixelTuner.DefaultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:properties="clr-namespace:PixelTuner.Properties"
        xmlns:iPmaskedtextbox="clr-namespace:IPmaskedtextbox;assembly=Toolkit"
        Title="{StaticResource Menu_Settings_Defaults_Window}" 
        Height="300" 
        Width="520" 
        WindowStyle="ToolWindow" 
        ResizeMode="NoResize" >
    <Window.Resources>
        <ResourceDictionary >
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="6,2">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Height="30" HorizontalAlignment="Right" Name="stackPanel1" VerticalAlignment="Top" Orientation="Horizontal" FlowDirection="RightToLeft">
            <Button Content="Cancel" Height="23" Name="CancelButton" Width="75" Click="CancelButton_Click" TabIndex="201" IsTabStop="True" />
            <Button Content="OK" Height="23" Name="OKButton" Width="75" Margin="4,0,0,0" Click="OKButton_Click" TabIndex="200" />
        </StackPanel>
        <TabControl Name="boxTabControl">
            <TabItem Header="{StaticResource Menu_Settings_Defaults_Software}" IsSelected="True" TabIndex="1">
                <StackPanel Height="236" HorizontalAlignment="Left" Name="stackPanel2" VerticalAlignment="Top" Orientation="Horizontal" Grid.RowSpan="2">
                    <StackPanel Name="stackPanel3" Width="81">
                        <CheckBox x:Name="boxUseTimeSpan" IsChecked="{Binding UseTimeSpan}" Margin="4" TabIndex="10" />
                        <CheckBox x:Name="boxCollapseGaps" IsChecked="{Binding CollapseGaps}" Margin="4" TabIndex="10" />
                        <xctk:DoubleUpDown Minimum="1" Maximum="500" FormatString="F3" Value="{Binding DefaultDuration}" Margin="2,2,0,3" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsManipulationEnabled="True" ParsingNumberStyle="AllowDecimalPoint" Increment="0.1" UseLayoutRounding="True" TabIndex="30" IsTabStop="True" />
                        <xctk:DoubleUpDown Minimum="4" Maximum="46" Value="{Binding Stretching}" Margin="2,0,0,3" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsManipulationEnabled="True" ParsingNumberStyle="Integer" TabIndex="40" IsTabStop="True" />
                        <Slider Minimum="0" Maximum="2" Value="{Binding ElementName=stackPanel3, Path=DataContext.Compression, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" TickPlacement="Both" SmallChange="1" IsSnapToTickEnabled="True" FlowDirection="RightToLeft" TabIndex="60" />
                        <xctk:DoubleUpDown Minimum="6" Maximum="150" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MaximumStretching}" Margin="2,2,0,3" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsManipulationEnabled="True" ParsingNumberStyle="Integer" IsTabStop="True" />
                        <xctk:DoubleUpDown Minimum="1" Maximum="200" Margin="2,0,0,3" Value="{Binding Path=Discreteness, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Increment="5" />
                    </StackPanel>
                    <StackPanel Name="stackPanel4" ForceCursor="True">
                        <Label Content="{StaticResource Menu_Settings_Defaults_UseTimespan}" Height="22" Padding="6,2,0,0" Name="label5" />
                        <Label Content="{StaticResource Menu_Settings_Defaults_CollapseGaps}" Height="22" Padding="6,2,0,0" Name="label1" />
                        <Label Content="{StaticResource Menu_Settings_Defaults_Duration}" Height="22" Padding="6,2,0,0" />
                        <Label Content="{StaticResource Menu_Settings_Defaults_Stretching}" Height="22" Padding="6,2,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{StaticResource Menu_Settings_Defaults_Compression}" Height="22" Padding="6,7,0,0" />
                            <Label Content="{Binding ElementName=stackPanel3, Path=DataContext.CompressionText}" Height="22" Padding="6,7,0,0" />
                        </StackPanel>
                        <Label Content="{StaticResource Menu_Settings_Defaults_MaxStretching}" Height="32" Padding="6,14,0,0"/>
                        <Label Content="{StaticResource Menu_Settings_Defaults_Rate}" Height="26" Padding="6,4,0,0" Name="label6" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="{StaticResource Menu_Settings_Defaults_Device}" TabIndex="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Orientation="Horizontal" Grid.RowSpan="2">
                        <StackPanel Width="81">
                            <CheckBox x:Name="boxExitMenuOnDoubleClick" IsChecked="{Binding ExitMenuOnDoubleClick}" Margin="4" TabIndex="20" />
                            <Slider Minimum="0" Maximum="30" Value="{Binding ElementName=stackPanel3, Path=DataContext.FadeDownMenuAfter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" TabIndex="50" />
                        </StackPanel>
                        <StackPanel ForceCursor="True">
                            <Label Content="{StaticResource Menu_Settings_Defaults_ExitMenuOnDoubleClick}" Height="22" Padding="6,2,0,0"/>
                            <Grid>
                                <Label Content="{StaticResource Menu_Settings_Defaults_DontTurnOff}" Visibility="{Binding ElementName=stackPanel3, Path=DataContext.DontFadeDownVisibility, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="6,3,0,0" />
                                <Label Content="{Binding ElementName=stackPanel3, Path=DataContext.FadeDownText}" Visibility="{Binding ElementName=stackPanel3, Path=DataContext.FadeDownVisibility, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="6,3,0,0" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <Button Command="{Binding WriteSettingsCommand}" HorizontalAlignment="Right" Content="{StaticResource Menu_Settings_Defaults_WriteDeviceSettings}" Margin="4" Height="28" Name="boxWriteSettings" Style="{StaticResource BlueLinkButton}" Grid.Row="1" />
                </Grid>
            </TabItem>
            <TabItem Header="Hoop/Video Module" TabIndex="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical" Margin="4">
                        <TextBlock Text="SSId:" Margin="2" TextAlignment="Right"></TextBlock>
                        <TextBlock Text="Pass:" Margin="2, 4" TextAlignment="Right"></TextBlock>
                        <TextBlock Text="Tag:" Margin="2,4" TextAlignment="Right"></TextBlock>
                        <TextBlock Text="IP:" Margin="2" TextAlignment="Right"></TextBlock>
                        <TextBlock Text="Port:" Margin="2,4" TextAlignment="Right"></TextBlock>
                        <TextBlock Text="LEDs count:" Margin="2" TextAlignment="Right"></TextBlock>
                        <TextBlock Text="LEDs type:" Margin="2,4" TextAlignment="Right"></TextBlock>
                        <TextBlock Text="Multicast address:" Margin="2,4" TextAlignment="Right"></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="4">
                        <xctk:MaskedTextBox Name="boxSSId" Text="{Binding Ssid}" ToolTip="Hotspot wifi network" MaxLength="10" Height="22" HorizontalAlignment="Stretch"/>
                        <xctk:MaskedTextBox Name="boxPass" Text="{Binding WifiPass}" ToolTip="Hotspot wifi pass" MaxLength="14" Height="22" HorizontalAlignment="Stretch"/>
                        <xctk:MaskedTextBox Name="boxTag" Text="{Binding WifiTag}" ToolTip="Video module or pixel hoop tag" MaxLength="10" Height="22" HorizontalAlignment="Stretch"/>
                        <iPmaskedtextbox:IPMaskedTextBox Name="boxIP" ToolTip="PixelTuner hosting machine IP" Height="22" Background="White" HorizontalAlignment="Left"/>
                        <xctk:DecimalUpDown Name="boxPort" Value="{Binding WifiPort}" Width="124" Minimum="0" Background="White" Maximum="65535" HorizontalAlignment="Left" Height="18" Margin="2,2,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <xctk:DecimalUpDown Name="boxLedsCount1" Value="{Binding LedsCount1}" ToolTip="channel1" Width="60" Minimum="0" Background="White" Maximum="512" HorizontalAlignment="Left" Height="18" Margin="2,2,0,2"/>
                            <xctk:DecimalUpDown Name="boxLedsCount2" Value="{Binding LedsCount2}" ToolTip="channel2" Width="60" Minimum="0" Background="White" Maximum="512" HorizontalAlignment="Left" Height="18" Margin="2,2,0,2"/>
                        </StackPanel>
                        <ComboBox Name="boxLedsType" Width="124" Height="22" HorizontalAlignment="Left" ItemsSource="{Binding SupportedLedTypes}"/>
                        <iPmaskedtextbox:IPMaskedTextBox Name="boxMulticastIP" ToolTip="Subnet multicas address (ends on .255 like x.x.x.255)" Height="22" Background="White" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button Name="boxDoIt" Grid.Row="1" Grid.Column="1" Style="{StaticResource BlueLinkButton}" HorizontalAlignment="Right" Content="Write to connected devices" Click="boxDoIt_Click"></Button>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
