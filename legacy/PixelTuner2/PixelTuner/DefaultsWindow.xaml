<Window x:Class="PixelTuner.DefaultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Menu_Settings_Defaults_Window}" Height="157" Width="505" xmlns:my="clr-namespace:PixelTuner" WindowStyle="ToolWindow" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Height="25" HorizontalAlignment="Right" Name="stackPanel1" VerticalAlignment="Top" Orientation="Horizontal" FlowDirection="RightToLeft">
            <Button Content="Cancel" Height="23" Name="CancelButton" Width="75" Click="CancelButton_Click" />
            <Button Content="OK" Height="23" Name="OKButton" Width="75" Margin="4,0,0,0" Click="OKButton_Click"/>
        </StackPanel>
        <StackPanel Height="236" HorizontalAlignment="Left" Name="stackPanel2" VerticalAlignment="Top" Orientation="Horizontal" Grid.RowSpan="2">
            <StackPanel Name="stackPanel3" Width="81">
                <my:NumericUpDownControl x:Name="numericUpDownControl1" MinValue="1" MaxValue="500" Margin="2,0,0,3" KeyDown="numeric_KeyDown" Value="{Binding Path=Parent.DataContext.DefaultDuration, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                <my:NumericUpDownControl x:Name="numericUpDownControl2" MinValue="4" MaxValue="46"  Margin="2,0,0,3" KeyDown="numeric_KeyDown" Value="{Binding Path=Parent.DataContext.Stretching, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                <Slider Minimum="0" Maximum="30" Value="{Binding ElementName=stackPanel3, Path=DataContext.TurnOffMenuAfter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Name="stackPanel4">
                <Label Content="{StaticResource Menu_Settings_Defaults_Duration}" Height="22" Padding="6,2,0,0" Name="label1" />
                <Label Content="{StaticResource Menu_Settings_Defaults_Stretching}" Height="22" Padding="6,2,0,0"  Name="label2" />
                <Grid>
                    <Label Content="{StaticResource Menu_Settings_Defaults_DontTurnOff}" Visibility="{Binding ElementName=stackPanel3, Path=DataContext.DontTurnOffVisibility, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="6,2,0,0"  Name="label3" />
                    <Label Content="{Binding ElementName=stackPanel3, Path=DataContext.TurnOffText}" Visibility="{Binding ElementName=stackPanel3, Path=DataContext.TurnOffVisibility, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="6,2,0,0"  Name="label4" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
