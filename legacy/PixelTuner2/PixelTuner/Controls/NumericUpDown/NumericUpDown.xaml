<UserControl x:Class="PixelTuner.Controls.NumericUpDownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PixelTuner"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="40">
    <UserControl.Resources>
        <Style x:Key="ButtonDownStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border MinWidth="6" MinHeight="4">
                            <Image x:Name="DownImage" Source="/PixelTuner;component/Images/_grey_Arrow-Down.png"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-DownLight.png" TargetName="DownImage"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-DownDisabled.png" TargetName="DownImage"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonUpStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border MinWidth="6" MinHeight="4">
                            <Image x:Name="UpImage" Source="/PixelTuner;component/Images/_grey_Arrow-Up.png"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-UpLight.png" TargetName="UpImage"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Source" Value="/PixelTuner;component/Images/_grey_Arrow-UpDisabled.png" TargetName="UpImage"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <TextBox x:Name="textField" Grid.RowSpan="2" IsReadOnly="True" Text="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <Button Height="8" Grid.Column="1" Grid.Row="0" Style="{StaticResource ButtonUpStyle}" Click="Button_Click_Up" />
        <Button Height="8" Grid.Column="1" Grid.Row="1" Style="{StaticResource ButtonDownStyle}" Click="Button_Click_Down" />
    </Grid>
</UserControl>
