<Window x:Class="PixelTuner.PictureEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:drawing="clr-namespace:PixelTuner.Drawing"
        Name="FormPictureEditor"
        Title="PictureEditor" Height="328" Width="1024">
    <StackPanel>
    <WindowsFormsHost Height="{Binding ElementName=FormPictureEditor, Path=CanvasHeight, UpdateSourceTrigger=PropertyChanged}" 
                                  Width="{Binding ElementName=FormPictureEditor, Path=Width}"
                                  HorizontalAlignment="Left" 
                                  Margin="0,0,0,0" 
                                  Name="windowsFormsHost" 
                                  VerticalAlignment="Top">
                    <!--<drawing:DrawControl Name="drawControl" Height="250"></drawing:DrawControl>-->
                </WindowsFormsHost>
    </StackPanel>
</Window>
