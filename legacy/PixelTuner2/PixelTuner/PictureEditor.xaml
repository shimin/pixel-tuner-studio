<Window x:Class="PixelTuner.PictureEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:drawing="clr-namespace:PixelTuner.Drawing"
        KeyDown="PictureEditor_OnKeyDown"
        Name="FormPictureEditor"
        Title="{StaticResource PictureEditor_WindowTitle}" Height="350" Width="800">
    <ScrollViewer>
        <WindowsFormsHost Height="{Binding ElementName=FormPictureEditor, Path=CanvasHeight, UpdateSourceTrigger=PropertyChanged}" 
                                  Width="{Binding ElementName=FormPictureEditor, Path=CanvasWidth}"
                                  HorizontalAlignment="Left" 
                                  Margin="0,0,0,0" 
                                  Name="windowsFormsHost" 
                                  VerticalAlignment="Top">
        </WindowsFormsHost>
    </ScrollViewer>
</Window>
