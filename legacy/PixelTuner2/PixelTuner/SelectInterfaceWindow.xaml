<Window x:Class="PixelTuner.SelectInterfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelTuner"
        mc:Ignorable="d"
        Title="SelectInterfaceWindow" Height="98" Width="420"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"></RowDefinition>
            <RowDefinition Height="29"></RowDefinition>
        </Grid.RowDefinitions>
        <ComboBox x:Name="boxInterfaces" ToolTip="Network interface to communicate" VerticalAlignment="Top" HorizontalContentAlignment="Center" Margin="8,4" Height="25" SelectionChanged="BoxInterfaces_OnSelectionChanged"></ComboBox>
        <DockPanel Grid.Row="1" HorizontalAlignment="Stretch" Height="25" Margin="8,2">
            <Button Content="OK" MinWidth="150" HorizontalAlignment="Stretch" IsDefault="True" Click="Button_Click"></Button>
            <Button Content="Cancel" HorizontalAlignment="Stretch" Margin="8,0,0,0"  Click="ButtonBase_OnClick"></Button>
        </DockPanel>
    </Grid>
</Window>
