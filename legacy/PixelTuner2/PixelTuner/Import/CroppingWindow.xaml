<Window x:Class="PixelTuner.Import.CroppingWindow"
    Title="Import image"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    
    Width="900" Height="600" Background="#FF323232" Loaded="Window_Loaded"
    SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
    	    <Grid.ColumnDefinitions>
    		    <ColumnDefinition/>
    		    <ColumnDefinition Width="Auto"/>
    	    </Grid.ColumnDefinitions>
    	    <Grid.RowDefinitions>
    		    <RowDefinition/>
    		    <RowDefinition Height="Auto"/>
    	    </Grid.RowDefinitions>
                <Image x:Name="boxImage" 
                       Margin="5,5,5,5"
                       RenderTransformOrigin="0.722,0.713" 
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Stretch="Uniform" 
                       Source="{Binding ImageToCrop}"
                       PreviewMouseDown="boxImage_PreviewMouseDown"
                       PreviewMouseMove="boxImage_PreviewMouseMove"
                       PreviewMouseUp="boxImage_PreviewMouseUp"/>
            
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="Auto" Height="Auto" Grid.Column="1" Background="{x:Null}">
			<StackPanel.Resources>
				<Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
					<Setter Property="Margin" Value="5,5,5,5"/>
				</Style>
			</StackPanel.Resources>
    		<Image x:Name="imgCrop" Width="130" Height="100" Margin="0,5,5,0"/>
    		<GroupBox Foreground="#FFFFFFFF" Header="Resize to fit" Margin="0,5,5,0" BorderThickness="0.25" BorderBrush="#FFFFFFFF">
    			<StackPanel Height="Auto">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Height" Margin="0,1,5,0"/>
                        <xctk:DoubleUpDown x:Name="boxHeight" Value="{Binding ResizeHeightValue}" Increment="5" Minimum="25" Maximum="200" />
                        <TextBlock Text="px" Margin="5,1,5,0"/>
                    </StackPanel>
                    <CheckBox x:Name="boxApplySharpening" Content="Apply Sharpening" IsChecked="{Binding ApplySharpening}" Foreground="#ffffffff" />
                </StackPanel>
    		</GroupBox>
        </StackPanel>
            <TextBlock HorizontalAlignment="Stretch" Grid.Row="1" Margin="5,0,0,5" x:Name="boxClippingRectangleInfo" Width="Auto" Height="Auto" Foreground="#FFFFFFFF" Text="ClippingRectangle" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" Height="Auto">
                <Button x:Name="boxOK" Content="OK" Width="64" Margin="5,4,2,4" Click="boxOK_Click" />
                <Button x:Name="boxCancel" Content="Cancel" Width="64" Margin="2,4,2,4" Click="boxCancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
