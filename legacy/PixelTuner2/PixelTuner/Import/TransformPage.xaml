<UserControl x:Class="PixelTuner.Import.TransformPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:img="clr-namespace:Common.Imaging;assembly=Common"
             mc:Ignorable="d" 
             Background="#FF323232"
             Name="boxTransformPage"
             d:DesignHeight="400" d:DesignWidth="660">
    <UserControl.Resources>
        <img:ImageConverter x:Key="ImageConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Image x:Name="boxImage"
               Grid.Column="0"
               Stretch="Fill"
               ClipToBounds="True"
               Source="{Binding ResultImage}">
        </Image>
        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="6">
            <TextBlock Text="{StaticResource ImportWindow_Top}" Foreground="White"/>
            <Slider Name="boxTop" Minimum="0.51" Maximum="1" Value="{Binding TopOffset}"/>
            <TextBlock Text="{StaticResource ImportWindow_Middle}" Foreground="White"/>
            <Slider Name="boxMiddle" Minimum="0.51" Maximum="1" Value="{Binding MiddleOffset}"/>
            <TextBlock Text="{StaticResource ImportWindow_Bottom}" Foreground="White"/>
            <Slider Name="boxBottom" Minimum="0.51" Maximum="1" Value="{Binding BottomOffset}"/>
            <Button Name="boxSkipBtn" Content="{StaticResource ImportWindow_Skip}" Margin="4" Command="{Binding SkipCommand}"></Button>
        </StackPanel>
    </Grid>
</UserControl>
