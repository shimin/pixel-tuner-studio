<Window x:Class="PixelTuner.Import.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pts="clr-namespace:Workspace.PageTransitions;assembly=Workspace.PageTransitions"
        Keyboard.PreviewKeyDown="Window_PreviewKeyDown"
        Title="ImportWindow" Width="900" Height="600" Background="#FF323232">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="724*" />
                <ColumnDefinition Width="154" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="492*" />
                <RowDefinition Height="39" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <pts:PageTransition Grid.ColumnSpan="2" Name="pageTransitionControl" Margin="0" TransitionType="Fade" />

            <Grid Grid.Row="1" Grid.RowSpan="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="612*" />
                    <ColumnDefinition Width="150*" />
                </Grid.ColumnDefinitions>
                <Button Name="btnPrevPage" HorizontalAlignment="Right" Width="140" Margin="5" Content="back" Command="{Binding BackCommand}" />
                <Button Name="btnNextPage" Grid.Column="1" Margin="5" Width="Auto" Content="next" Command="{Binding NextCommand}" />
            </Grid>
            <Button Name="boxOK" Content="OK" Grid.Column="1" Grid.Row="1" Margin="32,5,32,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="boxOK_Click" />
            <Button Name="boxCancel" Content="Cancel" Grid.Column="1" Grid.Row="2" Margin="32,0,32,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="boxCancel_Click" />
        </Grid>
    </Grid>
</Window>
