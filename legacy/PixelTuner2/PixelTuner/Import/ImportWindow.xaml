<Window x:Class="PixelTuner.Import.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pts="clr-namespace:Workspace.PageTransitions;assembly=Workspace.PageTransitions"
        xmlns:ptw="clr-namespace:Common.ProjectPlayer.PixelTwister;assembly=Common"
        xmlns:properties="clr-namespace:PixelTuner.Properties"
        xmlns:vm="clr-namespace:PixelTuner.ViewModel"
        Keyboard.PreviewKeyDown="Window_PreviewKeyDown"
        Name="boxWindow"
        Title="{StaticResource ImportWindow_Header}" Width="900" Height="600" Background="#FF323232">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PixelTuner;component/Styles/ProjectPlayerLayoutTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Name="boxGrid">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="724*" />
                <ColumnDefinition Width="154" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="492*" />
                <RowDefinition Height="39" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <TabControl Name="boxTabs" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0">
                <TabItem Name="boxMainTab" Header="{StaticResource ImportWindow_EditHeader}" >
                    <pts:PageTransition Name="pageTransitionControl" Margin="0" TransitionType="Fade" />
                </TabItem>
                <TabItem Name="boxPreviewTab" 
                         Header="{StaticResource ImportWindow_PreviewHeader}" 
                         IsEnabled="{Binding ElementName=boxMainTab, Path=Content.DataContext.IsPreviewOn}" 
                         ContentTemplate="{StaticResource ProjectPlayerLayoutTemplate}">
                </TabItem>
            </TabControl>
            <Grid Grid.Row="1" Grid.RowSpan="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="612*" />
                    <ColumnDefinition Width="150*" />
                </Grid.ColumnDefinitions>
                <Button Name="btnPrevPage" HorizontalAlignment="Right" Width="140" Margin="5" Content="{StaticResource ImportWindow_Back}" Command="{Binding BackCommand}" />
                <Button Name="btnNextPage" Grid.Column="1" Margin="5" Width="Auto" Content="{StaticResource ImportWindow_Next}" Command="{Binding NextCommand}" />
            </Grid>
            <Button Name="boxOK" Content="OK" Grid.Column="1" Grid.Row="1" Margin="32,5,32,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="boxOK_Click" />
            <Button Name="boxCancel" Content="Cancel" Grid.Column="1" Grid.Row="2" Margin="32,0,32,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="boxCancel_Click" />
        </Grid>
    </Grid>
</Window>
