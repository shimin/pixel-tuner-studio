<UserControl x:Class="PixelTuner.Import.CropPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonDock="http://schemas.xceed.com/wpf/xaml/avalondock"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" Background="#FF323232"
             Loaded="PageLoaded"
             d:DesignHeight="358" d:DesignWidth="625">
    <UserControl.Resources>
        <avalonDock:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image x:Name="boxImage" 
               Margin="5,5,5,5"
               RenderTransformOrigin="0.722,0.713" 
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               Stretch="Uniform" 
               Source="{Binding ImageToCrop}"
               PreviewMouseDown="boxImage_PreviewMouseDown"
               PreviewMouseMove="boxImage_PreviewMouseMove"
               PreviewMouseUp="boxImage_PreviewMouseUp"/>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="Auto" Height="Auto" Grid.Column="1" Background="{x:Null}">
            <StackPanel.Resources>
                <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
                    <Setter Property="Margin" Value="5,5,5,5"/>
                </Style>
            </StackPanel.Resources>
            <Image x:Name="imgCrop" Width="280" Height="200" Margin="0,5,5,0"/>
            <GroupBox Visibility="{Binding ResizeAllowed, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="#FFFFFFFF" Header="Resize to fit" Margin="0,5,5,0" BorderThickness="0.25" BorderBrush="#FFFFFFFF">
                <StackPanel Height="Auto">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Height" Margin="0,1,10,0"/>
                        <xctk:DoubleUpDown x:Name="boxHeight" Value="{Binding ResizeHeightValue}" Increment="5" Minimum="25" Maximum="200" Width="64"/>
                        <TextBlock Text="px" Margin="5,1,5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Button Name="boxFlipVertical" Click="boxFlipVertical_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Name="FlipVBtnImageBorder" Width="22" Height="22" Opacity="0.75" Margin="2" ToolTip="Flip vertically">
                                        <Image x:Name="FlipVBtnImage" Source="/PixelTuner;component/Images/flipVertically.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter Property="Source" Value="/PixelTuner;component/Images/flipVertically.png" TargetName="FlipVBtnImage"/>
                                            <Setter Property="Opacity" Value="1" TargetName="FlipVBtnImageBorder"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Name="boxFlipHorizontal" Click="boxFlipHorizontal_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Name="FlipHBtnImageBorder" Opacity="0.75" Width="22" Height="22" Margin="2" ToolTip="Flip horizontally">
                                        <Image x:Name="FlipHBtnImage" Source="/PixelTuner;component/Images/flipHorizontally.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter Property="Source" Value="/PixelTuner;component/Images/flipHorizontally.png" TargetName="FlipHBtnImage"/>
                                            <Setter Property="Opacity" Value="1" TargetName="FlipHBtnImageBorder"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Name="boxRotateLeft" Click="boxRotateLeft_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Name="rotateLeftImageBorder" Opacity="0.75" Width="20" Height="20" Margin="2" ToolTip="Rotate 90&#176; left">
                                        <Image x:Name="rotateLeftImage" Source="/PixelTuner;component/Images/RotateLeft.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter Property="Source" Value="/PixelTuner;component/Images/RotateLeft.png" TargetName="rotateLeftImage"/>
                                            <Setter Property="Opacity" Value="1" TargetName="rotateLeftImageBorder"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Name="boxRotateRight" Click="boxRotateRight_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Name="rotateRightImageBorder" Opacity="0.75" Width="20" Height="20" Margin="2" ToolTip="Rotate 90&#176; right">
                                        <Image x:Name="rotateRightImage" Source="/PixelTuner;component/Images/rotateRight.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter Property="Source" Value="/PixelTuner;component/Images/rotateRight.png" TargetName="rotateRightImage"/>
                                            <Setter Property="Opacity" Value="1" TargetName="rotateRightImageBorder"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <TextBlock HorizontalAlignment="Stretch" Grid.Row="1" Margin="5,0,0,5" x:Name="boxClippingRectangleInfo" Width="Auto" Height="Auto" Foreground="#FFFFFFFF" Text="{StaticResource CropPage_ClippingRectangle}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
