<Window x:Class="PixelTuner.EffectSquareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Focusable="True"
        PreviewKeyDown="Window_KeyDown"
        ContentRendered="Window_ContentRendered" Height="186" Width="170" WindowStyle="None" WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Grid Margin="6,3,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="2" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Grid.ColumnSpan="6" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Image Source="/PixelTuner;component/Effects/02_effect.png"/>
        </Border>
        <xctk:ColorPicker SelectedColor="{Binding ColorFirst}" Name="boxC1" Grid.Row="2" Grid.ColumnSpan="5"></xctk:ColorPicker>
        <xctk:ColorPicker SelectedColor="{Binding ColorLast}" Name="boxC2" Grid.Row="3" Grid.ColumnSpan="5"></xctk:ColorPicker>

        <xctk:DecimalUpDown Value="{Binding T1}" Name="boxT1" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Minimum="0" Increment="10"></xctk:DecimalUpDown>
        <xctk:DecimalUpDown Value="{Binding T2}" Name="boxT2" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Minimum="0" Increment="10"></xctk:DecimalUpDown>
        
        <Label Grid.Row="4">t1</Label>
        <Label Grid.Row="5">t2</Label>

        <Label Grid.Row="4" Grid.Column="5">ms</Label>
        <Label Grid.Row="5" Grid.Column="5">ms</Label>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="6" Orientation="Horizontal">
            <Button Content="OK" TabIndex="90" Width="74" IsDefault="True" Click="OKButton_Click" />
            <Button Content="Cancel" TabIndex="100" Width="74" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
