<Window x:Class="PixelTuner.TimePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelTuner"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Height="55" 
        Width="170"
        WindowStyle="None" 
        WindowStartupLocation="Manual" 
        ContentRendered="Window_ContentRendered"
        ShowInTaskbar="False" 
        Topmost="True">
    <Grid Margin="6,3,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <xctk:DoubleUpDown Name="boxLengthMin" Value="{Binding Minutes}" FontWeight="{Binding DurationWeight, Mode=OneWay}" Grid.Column="0" Grid.Row="0" Minimum="0" Maximum="59" IsTabStop="True" Margin="0,1,0,1" TabIndex="30" ParsingNumberStyle="Integer" RenderTransformOrigin="0,0" SelectAllOnGotFocus="True" FormatString=""></xctk:DoubleUpDown>
        <xctk:DoubleUpDown Name="boxLengthSec" Value="{Binding Seconds}" FontWeight="{Binding DurationWeight, Mode=OneWay}" Grid.Column="2" Grid.Row="0" Minimum="0" Maximum="59" IsTabStop="True" Margin="0,1,0,1" TabIndex="40" ParsingNumberStyle="Integer" RenderTransformOrigin="0,0" SelectAllOnGotFocus="True" FormatString=""></xctk:DoubleUpDown>
        <xctk:DoubleUpDown Name="boxLengthMs"  Value="{Binding Milliseconds}" FontWeight="{Binding DurationWeight, Mode=OneWay}" Grid.Column="4" Grid.Row="0" Minimum="0" Maximum="999" IsTabStop="True" Margin="0,1,0,1" TabIndex="50" ParsingNumberStyle="Integer" RenderTransformOrigin="0,0" SelectAllOnGotFocus="True" FormatString=""></xctk:DoubleUpDown>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal">
            <Button Content="OK" TabIndex="0" Margin="2,3" Width="74" IsTabStop="True" IsDefault="True" Click="ButtonOK_Click" />
            <Button Content="Cancel" TabIndex="100" Margin="2,3" Width="74" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
