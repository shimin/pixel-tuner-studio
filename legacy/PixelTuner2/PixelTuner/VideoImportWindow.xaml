<Window x:Class="PixelTuner.VideoImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelTuner"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Import video" Height="212" Width="408" Background="#FF323232" WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner">
    <Grid Margin="1,3,-1,-3">
        <Label x:Name="boxSrcPath" Content="{Binding SourcePath}" ToolTip="{Binding SourcePath}" HorizontalAlignment="Left" Margin="8,7,0,0" VerticalAlignment="Top" Foreground="#FF8D8D8D"/>
        <Button x:Name="boxSetDest" Content="Import" IsDefault="True" HorizontalAlignment="Left" Margin="309,140,0,0" VerticalAlignment="Top" Width="75" Click="boxSetDest_Click" />
        <Image x:Name="image" Source="{Binding ThumbnailPath}" HorizontalAlignment="Left" Height="142" Margin="10,37,0,0" VerticalAlignment="Top" Width="202"/>
        <Label x:Name="label" Content="Fps: " HorizontalAlignment="Left" Margin="214,29,0,0" VerticalAlignment="Top" Foreground="#FF8D8D8D"/>
        <Label x:Name="labelFps" Content="Size: " HorizontalAlignment="Left" Margin="214,48,0,0" VerticalAlignment="Top" Foreground="#FF8D8D8D"/>
        <Label x:Name="label1" Content="{Binding Fps}" HorizontalAlignment="Left" Margin="242,29,0,0" VerticalAlignment="Top" Foreground="#FF8D8D8D"/>
        <Label x:Name="label2" Content="{Binding Size}" HorizontalAlignment="Left" Margin="242,48,0,0" VerticalAlignment="Top" Foreground="#FF8D8D8D"/>
        <Label x:Name="labelFps_Copy" Content="New size: " HorizontalAlignment="Left" Margin="214,79,0,0" VerticalAlignment="Top" Foreground="#FF8D8D8D"/>
        <TextBox x:Name="boxWidth" HorizontalAlignment="Left" ToolTip="Width" Height="23" Margin="282,83,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="41"/>
        <TextBox x:Name="boxHeight" HorizontalAlignment="Left" ToolTip="Height" Height="23" Margin="328,83,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="41"/>
        <ProgressBar Name="boxProgress" HorizontalAlignment="Left" Height="15" Margin="218,115,0,0" VerticalAlignment="Top" Width="166"/>
    </Grid>
</Window>
