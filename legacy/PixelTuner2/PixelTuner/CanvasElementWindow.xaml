<Window x:Class="PixelTuner.CanvasElementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gh="clr-namespace:Common.Helpers;assembly=Common"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:PixelTuner"
        mc:Ignorable="d"
        Title="CanvasElementWindow" 
        Width="600" Height="400"
        Background="DarkGray"
        WindowStyle="None" 
        WindowStartupLocation="CenterOwner" 
        PreviewKeyDown="Window_KeyDown"
        ResizeMode="CanResize" 
        Focusable="True"
        ShowInTaskbar="False" 
        Topmost="True">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!--<Grid gh:GridHelper.RowCount="{Binding RowsCount}" gh:GridHelper.ColumnCount="{Binding ColumnsCount}"/>-->

        <DataGrid Name="boxGrid" gh:DataGridColumnsHelper.BindableColumns="{Binding ColumnCollection}" ItemsSource="{Binding RowsData}" AutoGenerateColumns="False"/>
        
        <!--<DataGrid Name="boxGrid" DataContext=""-->

        <StackPanel Grid.Column="1">
            <xctk:DecimalUpDown Name="boxRows" Value="{Binding RowsCount}" Background="White" Margin="6"/>
            <xctk:DecimalUpDown Name="boxColumns" Value="{Binding ColumnsCount}" Background="White" Margin="6"/>
        </StackPanel>
        <DockPanel>
            <Path 
                  Grid.Row="0"
                  Stroke="{Binding Stroke}" 
                  StrokeThickness="1" 
                  Stretch="Uniform"
                  Data="{Binding Geometry}">
            </Path>
        </DockPanel>
        <Button Grid.Column="1" Name="boxCloseBtn" Content="Close" Grid.Row="1" Width="64" HorizontalAlignment="Right" Click="boxCloseBtn_Click" Margin="2"/>
    </Grid>
</Window>
