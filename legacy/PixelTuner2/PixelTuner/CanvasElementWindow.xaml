<Window x:Class="PixelTuner.CanvasElementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="{StaticResource ElementMarkup_Header}" 
        Width="600" Height="400"
        Background="DarkGray"
        WindowStyle="ToolWindow" 
        WindowStartupLocation="CenterOwner" 
        PreviewKeyDown="Window_KeyDown"
        ResizeMode="CanResize" 
        Focusable="True"
        ShowInTaskbar="False" 
        Topmost="False">
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="Button" x:Key="TransparentButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PixelTuner;component/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <!--<MediaElement Visibility="{Binding MediaVisible, Converter={StaticResource BoolToVisibilityConverter}}" Source="{Binding Path=Thumbnail.FullName}" />-->
        <DockPanel>
            <Path Name="boxFigure"
                  Grid.Row="0"
                  Stroke="{Binding Stroke}" 
                  StrokeThickness="1" 
                  Stretch="Uniform"
                  Data="{Binding Geometry}">
            </Path>
        </DockPanel>

        <ItemsControl 
            ItemsSource="{Binding LedTiles}"
            Width="{Binding ElementName=boxFigure, Path=ActualWidth}" 
            Height="{Binding ElementName=boxFigure, Path=ActualHeight}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button 
                        Background="Transparent" 
                        Command="{Binding TurnOnCommand}" 
                        Opacity="{Binding OpacityVal}" 
                        MouseLeftButtonDown="Button_MouseDown"
                        MouseDown="Button_MouseDown"
                        MouseEnter="Button_MouseEnter"
                        MouseDoubleClick="Button_OnMouseDoubleClick"
                        Margin="{Binding ElementName=boxTailGrid, Path=DataContext.TilesMargin}">
                        <Button.ToolTip>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding LedNumber}"/>
                                <!--<TextBlock Text="{Binding Selected}"/>-->
                            </StackPanel>
                        </Button.ToolTip>
                        <Button.Content>
                            <TextBlock Text="{Binding LedNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button.Content>
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Name="Border" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter Content="{TemplateBinding Content}" 
                                                      ContentTemplate="{TemplateBinding ContentTemplate}" 
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Button.IsFocused" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                    </Trigger>

                                    <Trigger Property="IsMouseOver" Value="False">
                                        <Setter TargetName="Border" Property="Background" Value="Transparent" />
                                        <Setter TargetName="Border" Property="Opacity" Value="1.0" />
                                    </Trigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="Opacity" From="0.2" To="1"></DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Border" Storyboard.TargetProperty="Opacity" From="0.2" To="0.2"></DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <DataTrigger Binding="{Binding Selected}" Value="true">
                                        <Setter TargetName="Border" Property="Background" Value="#a0ff0000"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Name="boxTailGrid" Columns="{Binding ColumnsCount}" Rows="{Binding RowsCount}" Background="Transparent" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <StackPanel Grid.Column="1">
            <TextBlock Text="{StaticResource ElementMarkup_Rows}"/>
            <xctk:DecimalUpDown Name="boxRows" Value="{Binding RowsCount}" Background="White" Margin="6" Minimum="0"/>
            <TextBlock Text="{StaticResource ElementMarkup_Columns}"/>
            <xctk:DecimalUpDown Name="boxColumns" Value="{Binding ColumnsCount}" Background="White" Margin="6" Minimum="0"/>
            <Button Content="{StaticResource ElementMarkup_Set}" Command="{Binding SetSizeCommand}"/>
            <TextBlock Text="Spacing: "/>
            <xctk:DecimalUpDown Name="boxTilesMargin" Value="{Binding TilesMargin}" Background="White" Margin="6" Minimum="0" Maximum="100"/>
        </StackPanel>
        
        <Button Grid.Column="1" Name="boxCloseBtn" Content="{StaticResource Menu_File_Close}" Grid.Row="1" Width="80" HorizontalAlignment="Right" Click="boxCloseBtn_Click" Margin="2"/>
    </Grid>
</Window>
