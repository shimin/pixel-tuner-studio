<Window x:Class="PixelTuner.TimelinesToUpload"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PixelTuner.ViewModel"
        Title="{StaticResource ChooseTimelinesWindowText}" Height="461" Width="300">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PixelTuner;component/Styles/SelectTimelineTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#ff404040">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Width="100" Margin="4,6" Content="{StaticResource SelectAllButton}" Name="boxSelect" Click="boxSelect_Click"/>
            <Button Width="100" Margin="4,6" Content="{StaticResource DeselectAllButton}" Name="boxDeselect" Click="boxDeselect_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!--<ItemsControl ItemsSource="{Binding TimeLines}" ItemTemplate="{StaticResource SelectTimelineTemplate}" />-->
            <Grid>
            <TextBlock Foreground="#aaaaaa" Text="{StaticResource TimelinesToUpload_NoLines}" Margin="12"/>
            <ItemsControl ItemsSource="{Binding TimeLines}">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type vm:LightTimeLineViewModel}">
                        <ItemsControl KeyboardNavigation.IsTabStop="False" VerticalAlignment="Stretch">
                            <Border x:Name="boxTimelineBorder" KeyboardNavigation.IsTabStop="False" Background="{Binding Background}">
                                <StackPanel KeyboardNavigation.IsTabStop="False" Height="60" Orientation="Horizontal">
                                    <Canvas KeyboardNavigation.IsTabStop="False" Width="{StaticResource FilePreviewAreaWidth}" Background="{Binding Background}">
                                        <Path 
                                            Stroke="Black" 
                                            StrokeThickness="1" 
                                            Fill="{Binding Path=MetaData.Fill}"
                                            RenderTransform="{Binding Path=PreviewTransform}"
                                            Data="{Binding Path=MetaData.Geometry}"/>
                                    </Canvas>
                                    <CheckBox IsChecked="{Binding IsSelectedToUpload}" Margin="22"/>
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type vm:PixelTimeLineViewModel}">
                        <ItemsControl KeyboardNavigation.IsTabStop="False">
                            <Border x:Name="boxTimelineBorder" KeyboardNavigation.IsTabStop="False" Background="{Binding Background}">
                                <StackPanel KeyboardNavigation.IsTabStop="False" Height="60" Orientation="Horizontal">
                                    <Canvas KeyboardNavigation.IsTabStop="False" Width="{StaticResource FilePreviewAreaWidth}" Background="{Binding Background}">
                                        <StackPanel Orientation="Horizontal" Margin="20">
                                            <TextBlock Text="Pixel poi timeline " Foreground="#7a7a7a"/>
                                            <TextBlock Text="{Binding LineHeight}" Foreground="#7a7a7a"/>
                                        </StackPanel>
                                    </Canvas>
                                    <CheckBox IsChecked="{Binding IsSelectedToUpload}" Margin="22" />
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:EpicPoiTimeLineViewModel}">
                        <ItemsControl KeyboardNavigation.IsTabStop="False">
                            <Border x:Name="boxTimelineBorder" KeyboardNavigation.IsTabStop="False" Background="{Binding Background}">
                                <StackPanel KeyboardNavigation.IsTabStop="False" Height="60" Orientation="Horizontal">
                                    <Canvas KeyboardNavigation.IsTabStop="False" Width="{StaticResource FilePreviewAreaWidth}" Background="{Binding Background}">
                                            <TextBlock Text="E-pic poi timeline " Margin="20" Foreground="#7a7a7a"/>
                                    </Canvas>
                                    <CheckBox IsChecked="{Binding IsSelectedToUpload}" Margin="22"/>
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft">
            <Button Margin="2" Content="Cancel" Width="80" Name="buttonCancel" Click="buttonCancel_Click" KeyboardNavigation.TabIndex="65535"/>
            <Button Margin="2" Content="OK" Width="80" Name="buttonOK" Click="buttonOK_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>