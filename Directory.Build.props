<Project>
  <!-- Common settings for every project under src/ and tests/.
       legacy/ has its own old-style projects and is not affected:
       those projects do not import this file because they are not SDK-style. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Product>Pixel Tuner</Product>
    <Company>Pixel Tuner</Company>
    <!-- The single place for the product versions. Libraries and Studio carry StudioVersion;
         the Stage heads take StageVersion. -->
    <StudioVersion>4.0.0</StudioVersion>
    <StageVersion>1.0.0</StageVersion>
    <Version>$(StudioVersion)</Version>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!-- Avalonia: compile XAML bindings, no reflection (needed for iOS AOT). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
</Project>
