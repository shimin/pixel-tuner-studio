<Project>
  <!-- Common settings for every project under src/ and tests/.
       legacy/ has its own old-style projects and is not affected:
       those projects do not import this file because they are not SDK-style. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Product>Pixel Tuner Studio</Product>
    <Company>Pixel Tuner</Company>
    <!-- The single place for the product version. -->
    <Version>4.0.0</Version>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!-- Avalonia: compile XAML bindings, no reflection (needed for iOS AOT). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
</Project>
