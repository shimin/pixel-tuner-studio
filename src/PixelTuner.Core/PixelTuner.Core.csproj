<Project Sdk="Microsoft.NET.Sdk">
  <!-- Project model shared by every platform. No UI and no platform APIs.
       Timelines, effects and .bin export move here from legacy/PixelTuner2 in phase 1. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelTuner.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Image decoding. The native library comes with Avalonia in every app head;
         tests add the native assets for their OS. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The schemas PixelTuner 2 came with: drawings of a body to mark the LEDs of the props on. -->
    <EmbeddedResource Include="Layout\Schemas\*.svg" LogicalName="PixelTuner.Core.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PixelTuner.Core.Tests" />
  </ItemGroup>
</Project>
