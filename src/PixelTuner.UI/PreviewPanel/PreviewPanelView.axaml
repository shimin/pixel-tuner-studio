<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PixelTuner.UI.Resources"
             xmlns:pv="using:PixelTuner.UI.PreviewPanel"
             x:Class="PixelTuner.UI.PreviewPanel.PreviewPanelView"
             x:DataType="pv:PreviewViewModel">
  <!-- What the selected timeline plays at the playhead, as its device would light it. -->
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <WrapPanel>
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
      <ComboBox SelectedIndex="{Binding PixelView}" IsVisible="{Binding IsPixel}" MinWidth="150" Margin="0,0,16,0">
        <ComboBoxItem Content="{x:Static res:Strings.Preview_Poi}" />
        <ComboBoxItem Content="{x:Static res:Strings.Preview_Hoop}" />
      </ComboBox>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPixel}" Margin="0,0,16,0">
        <TextBlock Classes="muted" Text="{x:Static res:Strings.Preview_Swing}" VerticalAlignment="Center" />
        <Slider Minimum="1" Maximum="12" Value="{Binding SwingSpeed}" Width="110" />
        <TextBlock Classes="muted" Text="{x:Static res:Strings.Preview_Pitch}" VerticalAlignment="Center" />
        <Slider Minimum="4" Maximum="40" Value="{Binding LedPitch}" Width="110" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHoop}">
        <TextBlock Classes="muted" Text="{x:Static res:Strings.Preview_Tail}" VerticalAlignment="Center" />
        <Slider Minimum="20" Maximum="400" Value="{Binding Tail}" Width="110" />
        <TextBlock Classes="muted" Text="{x:Static res:Strings.Preview_Orbit}" VerticalAlignment="Center" />
        <Slider Minimum="0.1" Maximum="6" Value="{Binding OrbitSpeed}" Width="110" />
      </StackPanel>
    </WrapPanel>

    <Panel Grid.Row="1" MinHeight="180">
      <pv:TimelinePreviewControl Preview="{Binding}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                 Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Margin="24" />
    </Panel>

    <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Info}" />
  </Grid>
</UserControl>
