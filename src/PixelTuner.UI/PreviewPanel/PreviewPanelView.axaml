<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PixelTuner.UI.Resources"
             xmlns:pv="using:PixelTuner.UI.PreviewPanel"
             x:Class="PixelTuner.UI.PreviewPanel.PreviewPanelView"
             x:DataType="pv:PreviewViewModel">
  <!-- What the selected timeline plays at the playhead, as its device would light it. -->
  <Grid ColumnDefinitions="190,*" ColumnSpacing="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="6" Margin="0,0,6,0">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ComboBox SelectedIndex="{Binding PixelView}" IsVisible="{Binding IsPixel}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="{x:Static res:Strings.Preview_Poi}" />
          <ComboBoxItem Content="{x:Static res:Strings.Preview_Hoop}" />
        </ComboBox>
        <StackPanel Spacing="0" IsVisible="{Binding IsPixel}">
          <TextBlock Classes="muted" Text="{x:Static res:Strings.Preview_Swing}" />
          <Slider Minimum="1" Maximum="12" Value="{Binding SwingSpeed}" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.Preview_Pitch}" />
          <Slider Minimum="4" Maximum="40" Value="{Binding LedPitch}" />
        </StackPanel>
        <StackPanel Spacing="0" IsVisible="{Binding IsHoop}">
          <TextBlock Classes="muted" Text="{x:Static res:Strings.Preview_Tail}" />
          <Slider Minimum="20" Maximum="400" Value="{Binding Tail}" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.Preview_Orbit}" />
          <Slider Minimum="0.1" Maximum="6" Value="{Binding OrbitSpeed}" />
        </StackPanel>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
      </StackPanel>
    </ScrollViewer>

    <Panel Grid.Column="1">
      <pv:TimelinePreviewControl Preview="{Binding}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                 Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Margin="24" />
    </Panel>
  </Grid>
</UserControl>
