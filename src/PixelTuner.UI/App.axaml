<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelTuner.UI.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the system light or dark theme on every platform. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PixelTuner.UI/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
