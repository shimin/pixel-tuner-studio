<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelTuner.UI.ViewModels"
        xmlns:views="using:PixelTuner.UI.Views"
        xmlns:res="using:PixelTuner.UI.Resources"
        x:Class="PixelTuner.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/studio_icon.png"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
  <!-- Desktop window for Windows and macOS. One menu definition: macOS shows it in the menu
       bar at the top of the screen, Windows shows it as a menu bar inside the window. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="{x:Static res:Strings.Menu_File}">
        <NativeMenu>
          <NativeMenuItem Header="{x:Static res:Strings.Command_NewProject}"
                          Command="{Binding NewProjectCommand}" Gesture="{x:Static views:Shortcuts.New}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_OpenProject}"
                          Command="{Binding OpenProjectCommand}" Gesture="{x:Static views:Shortcuts.Open}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_ImportLegacy}"
                          Command="{Binding ImportLegacyProjectCommand}" Gesture="{x:Static views:Shortcuts.Import}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{x:Static res:Strings.Command_Save}"
                          Command="{Binding SaveCommand}" Gesture="{x:Static views:Shortcuts.Save}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_SaveAs}"
                          Command="{Binding SaveAsCommand}" Gesture="{x:Static views:Shortcuts.SaveAs}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{x:Static res:Strings.Command_CloseProject}"
                          Command="{Binding CloseProjectCommand}" Gesture="{x:Static views:Shortcuts.Close}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_Exit}" IsVisible="{Binding ShowWindowsMenus}"
                          Command="{Binding ExitCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="{x:Static res:Strings.Menu_Edit}">
        <NativeMenu>
          <NativeMenuItem Header="{Binding UndoHeader}" Command="{Binding UndoCommand}" Gesture="{x:Static views:Shortcuts.Undo}" />
          <NativeMenuItem Header="{Binding RedoHeader}" Command="{Binding RedoCommand}" Gesture="{x:Static views:Shortcuts.Redo}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{x:Static res:Strings.Command_Delete}" Command="{Binding Editor.DeleteSelectedCommand}" Gesture="{x:Static views:Shortcuts.Delete}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="{x:Static res:Strings.Menu_Timeline}">
        <NativeMenu>
          <NativeMenuItem Header="{x:Static res:Strings.Command_AddPixelTimeline}" Command="{Binding Editor.AddPixelTimelineCommand}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_AddVideoTimeline}" Command="{Binding Editor.AddVideoTimelineCommand}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_AddEpicTimeline}" Command="{Binding Editor.AddEpicTimelineCommand}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_AddLightTimeline}" Command="{Binding Editor.AddLightTimelineCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{x:Static res:Strings.Command_SetSoundtrack}" Command="{Binding Editor.SetSoundtrackCommand}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_RemoveSoundtrack}" Command="{Binding Editor.RemoveSoundtrackCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{x:Static res:Strings.Command_AddMarker}" Command="{Binding Editor.AddMarkerCommand}" Gesture="{x:Static views:Shortcuts.AddMarker}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="{x:Static res:Strings.Menu_Playback}">
        <NativeMenu>
          <NativeMenuItem Header="{x:Static res:Strings.Command_PlayPause}" Command="{Binding Editor.PlayPauseCommand}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_Stop}" Command="{Binding Editor.StopCommand}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_ToStart}" Command="{Binding Editor.ToStartCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="{x:Static res:Strings.Menu_View}">
        <NativeMenu>
          <NativeMenuItem Header="{x:Static res:Strings.Command_ZoomIn}" Command="{Binding Editor.ZoomInCommand}" Gesture="{x:Static views:Shortcuts.ZoomIn}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_ZoomOut}" Command="{Binding Editor.ZoomOutCommand}" Gesture="{x:Static views:Shortcuts.ZoomOut}" />
          <NativeMenuItem Header="{x:Static res:Strings.Command_ZoomFit}" Command="{Binding Editor.ZoomFitCommand}" Gesture="{x:Static views:Shortcuts.ZoomFit}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="{x:Static res:Strings.Menu_Help}" IsVisible="{Binding ShowWindowsMenus}">
        <NativeMenu>
          <NativeMenuItem Header="{Binding AboutHeader}" Command="{Binding AboutCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <Window.KeyBindings>
    <KeyBinding Gesture="{x:Static views:Shortcuts.New}" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.Open}" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.Import}" Command="{Binding ImportLegacyProjectCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.Save}" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.SaveAs}" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.Undo}" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.Redo}" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.RedoAlternate}" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.AddMarker}" Command="{Binding Editor.AddMarkerCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.ZoomIn}" Command="{Binding Editor.ZoomInCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.ZoomOut}" Command="{Binding Editor.ZoomOutCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.ZoomFit}" Command="{Binding Editor.ZoomFitCommand}" />
    <KeyBinding Gesture="{x:Static views:Shortcuts.Close}" Command="{Binding CloseProjectCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <NativeMenuBar DockPanel.Dock="Top" />
    <views:MainView />
  </DockPanel>
</Window>
