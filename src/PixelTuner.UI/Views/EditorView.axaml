<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelTuner.UI.ViewModels"
             xmlns:res="using:PixelTuner.UI.Resources"
             xmlns:tl="using:PixelTuner.UI.Timelines"
             xmlns:lib="using:PixelTuner.UI.LibraryPanel"
             xmlns:led="using:PixelTuner.UI.LedLayouts"
             xmlns:pv="using:PixelTuner.UI.PreviewPanel"
             xmlns:dv="using:PixelTuner.UI.DevicesPanel"
             xmlns:core="using:PixelTuner.Core.Model"
             x:Class="PixelTuner.UI.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             Background="{DynamicResource PtSurfaceBrush}">
  <!-- Studio's editor: a toolbar, the timelines, and an inspector for the selection. -->
  <!-- Row 4 is the bottom panel: its height is the user's (the splitter above it) and does not follow the tab. -->
  <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto,320" ColumnDefinitions="*,Auto">
    <!-- The left margin is the corner buttons' space (TimelineEditor.CornerButtonGap): "Add timeline" fills the name column, and the marker button starts at its divider. -->
    <DockPanel Grid.ColumnSpan="2" Margin="6,8,12,8">
      <!-- Zoom is this slider, the wheel over the ruler, or Ctrl/Cmd and the wheel anywhere; the button fits the whole show. -->
      <Button DockPanel.Dock="Right" Content="↔" Command="{Binding ZoomFitCommand}" ToolTip.Tip="{x:Static res:Strings.Command_ZoomFit}" />
      <Slider DockPanel.Dock="Right" Minimum="0" Maximum="1" Width="140" Margin="0,0,8,0" VerticalAlignment="Center" Value="{Binding ZoomSlider}" ToolTip.Tip="{x:Static res:Strings.Command_Zoom}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="{x:Static res:Strings.Toolbar_AddTimeline}" Width="{x:Static tl:TimelineEditor.AddTimelineButtonWidth}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Button.Flyout>
            <!-- Opens under the button, along its left edge (the default centres it, and it sticks out of the window). -->
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="{x:Static res:Strings.Toolbar_AddPixel}" Command="{Binding AddPixelTimelineCommand}" />
              <MenuItem Header="{x:Static res:Strings.Toolbar_AddVideo}" Command="{Binding AddVideoTimelineCommand}" />
              <MenuItem Header="{x:Static res:Strings.Toolbar_AddEpic}" Command="{Binding AddEpicTimelineCommand}" />
              <MenuItem Header="{x:Static res:Strings.Toolbar_AddLight}" Command="{Binding AddLightTimelineCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <!-- Marker, play/pause and stop are squares of one size. -->
        <Button Content="⚑" Command="{Binding AddMarkerCommand}" ToolTip.Tip="{x:Static res:Strings.Command_AddMarker}" Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Button Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" ToolTip.Tip="{x:Static res:Strings.Command_PlayPause}" Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Button Content="■" Command="{Binding StopCommand}" ToolTip.Tip="{x:Static res:Strings.Command_Stop}" Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" FontFamily="Consolas,Menlo,monospace" Margin="4,0,0,0" />
      </StackPanel>
    </DockPanel>

    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="14,0,12,6" TextWrapping="Wrap"
               Foreground="{DynamicResource SystemFillColorCautionBrush}"
               Text="{Binding Message}" IsVisible="{Binding HasMessage}" />

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <tl:TimelineControl Editor="{Binding Timelines}" />
    </ScrollViewer>

    <!-- The inspector is longer than the room beside the timelines when the library is open: it scrolls. -->
    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
    <!-- The name of the panel is the button that folds it: open, a bar across the top of the panel; folded, the whole narrow strip. -->
    <Button DockPanel.Dock="Left" Width="28" Margin="8,0,0,12" Padding="0,8" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
            IsVisible="{Binding !IsInspectorVisible}" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="{Binding InspectorToggleTip}">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding InspectorToggleGlyph}" HorizontalAlignment="Center" />
        <LayoutTransformControl HorizontalAlignment="Center">
          <LayoutTransformControl.LayoutTransform><RotateTransform Angle="90" /></LayoutTransformControl.LayoutTransform>
          <TextBlock Text="{x:Static res:Strings.Inspector_Heading}" />
        </LayoutTransformControl>
      </StackPanel>
    </Button>
    <ScrollViewer Width="272" IsVisible="{Binding IsInspectorVisible}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Classes="card" Margin="8,0,0,12" VerticalAlignment="Top">
      <StackPanel Spacing="8">
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="28" Padding="10,2"
                Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="{Binding InspectorToggleTip}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Static res:Strings.Inspector_Heading}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding InspectorToggleGlyph}" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Inspector_Nothing}"
                   IsVisible="{Binding !HasSelection}" />
        <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding InspectorTitle}" />
          <StackPanel Spacing="4" IsVisible="{Binding CanRename}">
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Name}" />
            <!-- The document keeps the undo history, so the box must not keep its own. -->
            <TextBox Text="{Binding SelectionName}" IsUndoEnabled="False" />
          </StackPanel>
          <!-- What a timeline header controls: only the controls that write something into the .bin of its kind. -->
          <StackPanel Spacing="6" IsVisible="{Binding IsTimelineSelected}">
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_TimelineColor}" />
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="4" Margin="0,0,8,0" Background="{Binding TimelineColorBrush}"
                      BorderBrush="{DynamicResource PtMutedTextBrush}" BorderThickness="1" />
              <TextBox Text="{Binding TimelineColorText}" IsUndoEnabled="False" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Palette}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColorSwatch">
                  <Button Command="{Binding Pick}" Background="{Binding Brush}" Width="24" Height="24" Padding="0" Margin="0,0,4,4" CornerRadius="4" ToolTip.Tip="{Binding Hex}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Inspector_ColorNotWritten}" IsVisible="{Binding ColorIsOnlyALabel}" />
            <CheckBox Content="{x:Static res:Strings.Inspector_Flip}" IsChecked="{Binding FlipVertical}" IsVisible="{Binding ShowFlip}" />
            <CheckBox Content="{x:Static res:Strings.Inspector_Monochrome}" IsChecked="{Binding Monochrome}" IsVisible="{Binding ShowMonochrome}" />
            <StackPanel Spacing="4" IsVisible="{Binding ShowHeight}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Height}" />
              <NumericUpDown Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding TimelineHeight}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding HeightText}" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding ShowLayout}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Layout}" />
              <ComboBox ItemsSource="{Binding LayoutNames}" SelectedIndex="{Binding LayoutIndex}" HorizontalAlignment="Stretch" />
              <WrapPanel>
                <Button Content="{x:Static res:Strings.Layout_New}" Command="{Binding NewLayoutCommand}" Margin="0,0,6,0" />
                <Button Content="{x:Static res:Strings.Layout_Edit}" Command="{Binding EditLayoutCommand}" IsEnabled="{Binding CanEditLayout}" Margin="0,0,6,0" />
                <Button Content="{x:Static res:Strings.Layout_Delete}" Command="{Binding DeleteLayoutCommand}" IsEnabled="{Binding CanEditLayout}" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
          <!-- Times are typed as 1:05.250 (or 65.25) and applied on Enter or when the box loses focus. -->
          <StackPanel Spacing="4" IsVisible="{Binding IsItemSelected}">
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Start}" />
            <TextBox Text="{Binding StartText}" IsUndoEnabled="False" />
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Length}" />
            <TextBox Text="{Binding LengthText}" IsUndoEnabled="False" />
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding IsMultiSelection}">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Inspector_MultiHint}" />
            <Button Content="{x:Static res:Strings.Inspector_ApplyToAll}" Command="{Binding ApplyToAllCommand}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding IsItemSelected}">
            <StackPanel Spacing="4" IsVisible="{Binding ShowBrightness}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Brightness}" />
              <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding ShowStretching}">
              <TextBlock Classes="muted" Text="{Binding StretchingLabel}" />
              <NumericUpDown Minimum="2" Maximum="1000" Increment="1" FormatString="0" Value="{Binding Stretching}" />
              <TextBlock TextWrapping="Wrap" Text="{Binding ColumnTimeText}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PlaybackText}" />
            </StackPanel>
            <CheckBox Content="{x:Static res:Strings.Inspector_Laser}" IsChecked="{Binding LaserOn}" IsVisible="{Binding ShowLaser}" />
            <StackPanel Spacing="4" IsVisible="{Binding IsVideoSelected}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_OffsetX}" />
              <NumericUpDown Minimum="-100000" Maximum="100000" Increment="1" FormatString="0" Value="{Binding OffsetX}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_OffsetY}" />
              <NumericUpDown Minimum="-100000" Maximum="100000" Increment="1" FormatString="0" Value="{Binding OffsetY}" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding IsLightItem}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Color}" />
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="4" Margin="0,0,8,0" Background="{Binding ItemColorBrush}"
                        BorderBrush="{DynamicResource PtMutedTextBrush}" BorderThickness="1" />
                <TextBox Text="{Binding ItemColor}" IsUndoEnabled="False" />
              </DockPanel>
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding IsEffectSelected}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_ColorTo}" />
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="4" Margin="0,0,8,0" Background="{Binding ItemColorToBrush}"
                        BorderBrush="{DynamicResource PtMutedTextBrush}" BorderThickness="1" />
                <TextBox Text="{Binding ItemColorTo}" IsUndoEnabled="False" />
              </DockPanel>
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Effect}" />
              <ComboBox ItemsSource="{Binding EffectNames}" SelectedIndex="{Binding EffectIndex}" HorizontalAlignment="Stretch" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_T1}" />
              <NumericUpDown Minimum="0" Maximum="3600000" Increment="10" FormatString="0" Value="{Binding T1}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_T2}" />
              <NumericUpDown Minimum="0" Maximum="3600000" Increment="10" FormatString="0" Value="{Binding T2}" />
            </StackPanel>
            <!-- Where the item lands in the .bin of its device, and what the build says about it. -->
            <StackPanel Spacing="2" IsVisible="{Binding HasBinInfo}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Bin}" />
              <TextBlock TextWrapping="Wrap" Text="{Binding BinLine}" />
              <ItemsControl ItemsSource="{Binding BinIssues}" IsVisible="{Binding HasBinIssues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock TextWrapping="Wrap" Text="{Binding}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding HasPreview}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Preview}" />
              <Image Source="{Binding ItemPreviewBitmap}" MaxHeight="160" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding IsMarkerSelected}">
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Inspector_Position}" />
            <TextBox Text="{Binding PositionText}" IsUndoEnabled="False" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
    </ScrollViewer>
    </DockPanel>

    <!-- A bar between the timelines and the bottom panel: the splitter that sets the panel's height, and over its left end the button
         that folds the panel away (the bar then stays, to bring it back). -->
    <!-- (The splitter must be a child of the grid whose rows it resizes.) -->
    <GridSplitter Grid.Row="3" Grid.ColumnSpan="2" Height="28" Margin="12,0" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  IsEnabled="{Binding IsBottomPanelVisible}" />
    <Button Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" MinHeight="24" Height="24" Padding="10,0" Margin="12,0,0,0" FontSize="12"
            Command="{Binding ToggleBottomPanelCommand}" ToolTip.Tip="{Binding BottomPanelToggleTip}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Static res:Strings.Panels_Heading}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding BottomPanelToggleGlyph}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <!-- The bottom panel: the tabs stand in a column on the left, the tools of a tab in a column of its own, and the rest is the content,
         so nothing takes the height from it. While a picture is imported, the import panel takes the place of the library's list. -->
    <Border Grid.Row="4" Grid.ColumnSpan="2" Classes="card" Margin="12,0,12,12" Padding="8">
     <TabControl Classes="rail" TabStripPlacement="Left" Padding="12,0,0,0">
      <TabItem Header="{x:Static res:Strings.Library_Title}">
      <Grid ColumnDefinitions="190,*" ColumnSpacing="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6" Margin="0,0,6,0">
          <!-- A section for each kind of timeline, as PixelTuner 2 had a pane for each. -->
          <ListBox Classes="sections" ItemsSource="{x:Static lib:LibraryViewModel.Sections}" SelectedIndex="{Binding Gallery.SectionIndex}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="lib:LibrarySection"><TextBlock Text="{Binding Title}" /></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- One button for every kind of file: a GIF goes to Video, a picture to Pixel poi/hoop (or E-pic poi). -->
          <Button Classes="tool" Content="{x:Static res:Strings.Library_Import}" Command="{Binding Gallery.ImportCommand}" />
          <Button Classes="tool" Content="{x:Static res:Strings.Library_Place}" Command="{Binding Gallery.PlaceCommand}" />
          <Button Classes="tool" Content="{x:Static res:Strings.Library_Remove}" Command="{Binding Gallery.RemoveCommand}" IsVisible="{Binding !Gallery.IsFixedSection}" />
          <StackPanel Spacing="2" IsVisible="{Binding Gallery.HasHeightFilter}">
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Library_HeightFilter}" />
            <ComboBox ItemsSource="{Binding Gallery.HeightFilterItems}" SelectedIndex="{Binding Gallery.HeightFilterIndex}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <TextBox Text="{Binding Gallery.SelectedName}" IsVisible="{Binding Gallery.CanRename}" IsUndoEnabled="False" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Library_LightHint}" IsVisible="{Binding Gallery.IsFixedSection}" />
          <TextBlock Text="{Binding Gallery.Message}" IsVisible="{Binding Gallery.Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
        </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !Gallery.IsImporting}">
          <StackPanel Spacing="8">
            <ListBox ItemsSource="{Binding Gallery.Entries}" SelectedItem="{Binding Gallery.Selected}" Background="Transparent" DoubleTapped="OnEntryDoubleTapped">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="lib:LibraryEntryViewModel">
                  <StackPanel Width="104" Spacing="2" Opacity="{Binding Dim}" ToolTip.Tip="{Binding Reason}">
                    <Border Height="64" CornerRadius="4" ClipToBounds="True" Background="{Binding Swatch}">
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Library_Empty}" IsVisible="{Binding Gallery.IsEmpty}" />
            <StackPanel Spacing="4" IsVisible="{Binding Gallery.Missing.Count}">
              <TextBlock Text="{x:Static res:Strings.Library_MissingTitle}" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Gallery.Missing}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="lib:LibraryEntryViewModel">
                    <DockPanel Margin="0,0,0,4">
                      <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Library_Replace}"
                              Command="{Binding $parent[ItemsControl].((vm:EditorViewModel)DataContext).Gallery.ReplaceCommand}" CommandParameter="{Binding}" />
                      <TextBlock Text="{Binding Entry.SourcePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Import, in the steps of PixelTuner 2's window: cut, squeeze in perspective (optional), trim and scale to the
             height of the device and correct the colour. -->
        <Panel Grid.Column="1" IsVisible="{Binding Gallery.IsImporting}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:DataType="lib:ImportViewModel" DataContext="{Binding Gallery.Import}" RowDefinitions="Auto,*" RowSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{x:Static res:Strings.Import_StepCut}" Command="{Binding ShowCutCommand}" Classes.accent="{Binding IsCutStep}" />
            <Button Content="{x:Static res:Strings.Import_StepPerspective}" Command="{Binding ShowPerspectiveCommand}" Classes.accent="{Binding IsPerspectiveStep}" />
            <Button Content="{x:Static res:Strings.Import_StepFinish}" Command="{Binding ShowFinishCommand}" Classes.accent="{Binding IsFinishStep}" />
            <TextBlock Text="{Binding SourceName}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,*" ColumnSpacing="12">
            <Panel MinHeight="150">
              <lib:CropControl Source="{Binding SourceBitmap}" Crop="{Binding Cut}" IsVisible="{Binding IsCutStep}" />
              <Image Source="{Binding WarpedBitmap}" Stretch="Uniform" IsVisible="{Binding IsPerspectiveStep}" RenderOptions.BitmapInterpolationMode="MediumQuality" />
              <lib:CropControl Source="{Binding WarpedBitmap}" Crop="{Binding Trim}" IsVisible="{Binding IsTrimStep}" />
              <Image Source="{Binding ResultBitmap}" Stretch="Uniform" IsVisible="{Binding IsResultStep}" RenderOptions.BitmapInterpolationMode="None" />
            </Panel>

            <StackPanel Grid.Column="1" Spacing="4">
              <!-- Cut -->
              <StackPanel IsVisible="{Binding IsCutStep}"><StackPanel Spacing="4" DataContext="{Binding Cut}" x:DataType="lib:CropRect">
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,4,4"><TextBlock Classes="muted" Text="X" /><NumericUpDown Minimum="0" Maximum="100000" FormatString="0" Value="{Binding XBox}" /></StackPanel>
                  <StackPanel Margin="0,0,0,4"><TextBlock Classes="muted" Text="Y" /><NumericUpDown Minimum="0" Maximum="100000" FormatString="0" Value="{Binding YBox}" /></StackPanel>
                  <StackPanel Margin="0,0,4,4"><TextBlock Classes="muted" Text="W" /><NumericUpDown Minimum="1" Maximum="100000" FormatString="0" Value="{Binding WidthBox}" /></StackPanel>
                  <StackPanel Margin="0,0,0,4"><TextBlock Classes="muted" Text="H" /><NumericUpDown Minimum="1" Maximum="100000" FormatString="0" Value="{Binding HeightBox}" /></StackPanel>
                </UniformGrid>
              </StackPanel></StackPanel>
              <Button Content="↺" Command="{Binding ResetCutCommand}" HorizontalAlignment="Left" IsVisible="{Binding IsCutStep}" />

              <!-- Perspective -->
              <StackPanel Spacing="2" IsVisible="{Binding IsPerspectiveStep}">
                <CheckBox Content="{x:Static res:Strings.Import_Warp}" IsChecked="{Binding WarpEnabled}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Import_WarpHint}" />
                <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_WarpTop}" />
                <Slider Minimum="{Binding WarpMin}" Maximum="{Binding WarpMax}" Value="{Binding WarpTop}" IsEnabled="{Binding WarpEnabled}" />
                <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_WarpMiddle}" />
                <Slider Minimum="{Binding WarpMin}" Maximum="{Binding WarpMax}" Value="{Binding WarpMiddle}" IsEnabled="{Binding WarpEnabled}" />
                <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_WarpBottom}" />
                <Slider Minimum="{Binding WarpMin}" Maximum="{Binding WarpMax}" Value="{Binding WarpBottom}" IsEnabled="{Binding WarpEnabled}" />
              </StackPanel>

              <!-- Trim, scale -->
              <StackPanel Spacing="4" IsVisible="{Binding IsFinishStep}">
                <StackPanel IsVisible="{Binding IsTrimStep}"><StackPanel Spacing="4" DataContext="{Binding Trim}" x:DataType="lib:CropRect">
                  <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_Trim}" />
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,4,4"><TextBlock Classes="muted" Text="X" /><NumericUpDown Minimum="0" Maximum="100000" FormatString="0" Value="{Binding XBox}" /></StackPanel>
                    <StackPanel Margin="0,0,0,4"><TextBlock Classes="muted" Text="Y" /><NumericUpDown Minimum="0" Maximum="100000" FormatString="0" Value="{Binding YBox}" /></StackPanel>
                    <StackPanel Margin="0,0,4,4"><TextBlock Classes="muted" Text="W" /><NumericUpDown Minimum="1" Maximum="100000" FormatString="0" Value="{Binding WidthBox}" /></StackPanel>
                    <StackPanel Margin="0,0,0,4"><TextBlock Classes="muted" Text="H" /><NumericUpDown Minimum="1" Maximum="100000" FormatString="0" Value="{Binding HeightBox}" /></StackPanel>
                  </UniformGrid>
                </StackPanel></StackPanel>
                <Button Content="↺" Command="{Binding ResetTrimCommand}" HorizontalAlignment="Left" IsVisible="{Binding IsTrimStep}" />
                <CheckBox Content="{x:Static res:Strings.Import_Scale}" IsChecked="{Binding ScaleToHeight}" IsEnabled="{Binding !HeightIsFixed}" />
                <NumericUpDown Minimum="1" Maximum="65535" FormatString="0" Value="{Binding TargetHeightBox}" IsEnabled="{Binding !HeightIsFixed}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="2" IsVisible="{Binding IsFinishStep}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_Brightness}" />
              <Slider Minimum="-255" Maximum="255" Value="{Binding BrightnessSlider}" />
              <CheckBox Content="{x:Static res:Strings.Import_Midtones}" IsChecked="{Binding MidtonesOnly}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_Contrast}" />
              <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_Hue}" />
              <Slider Minimum="-180" Maximum="180" Value="{Binding HueSlider}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_Saturation}" />
              <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_Value}" />
              <Slider Minimum="-100" Maximum="100" Value="{Binding Value}" />
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_Sharpen}" />
              <Slider Minimum="0" Maximum="10" Value="{Binding Sharpen}" />
              <Button Content="↺" Command="{Binding ResetColourCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="6">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Import_Result}" />
              <Border MaxHeight="120" ClipToBounds="True" Background="Black" CornerRadius="4">
                <Image Source="{Binding ResultBitmap}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
              </Border>
              <TextBlock Text="{Binding ResultSize}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Import_WrongHeight}" IsVisible="{Binding !FitsTarget}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="{x:Static res:Strings.Import_Apply}" Command="{Binding ApplyCommand}" />
                <Button Content="{x:Static res:Strings.Import_Cancel}" Command="{Binding CancelCommand}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
        </ScrollViewer>
        </Panel>
      </Grid>
      </TabItem>
      <!-- What the selected timeline plays at the playhead, as its device would light it. -->
      <TabItem Header="{x:Static res:Strings.Preview_Title}">
        <pv:PreviewPanelView DataContext="{Binding Preview}" />
      </TabItem>
      <!-- The drawing of the props, with the markup state of each outline. -->
      <TabItem Header="{x:Static res:Strings.Canvas_Title}">
        <led:CanvasPanelView DataContext="{Binding Canvas}" />
      </TabItem>
      <!-- The devices of the project, what the files are built with, and the connected devices. -->
      <TabItem Header="{x:Static res:Strings.Devices_Title}">
        <dv:DevicesPanelView DataContext="{Binding Devices}" />
      </TabItem>
     </TabControl>
    </Border>

    <!-- The LED markup window takes the place of the whole editor while it is open. -->
    <Panel Grid.RowSpan="5" Grid.ColumnSpan="2" IsVisible="{Binding IsEditingMarkup}" Background="{DynamicResource PtSurfaceBrush}">
      <led:LedMarkupView DataContext="{Binding MarkupEditor}" />
    </Panel>
  </Grid>
</UserControl>
