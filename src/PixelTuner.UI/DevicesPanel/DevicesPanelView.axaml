<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:PixelTuner.UI.Resources"
             xmlns:dv="using:PixelTuner.UI.DevicesPanel"
             x:Class="PixelTuner.UI.DevicesPanel.DevicesPanelView"
             x:DataType="dv:DevicesPanelViewModel">
  <!-- The devices that are connected, what is sent to the selected one (set up here, sent by the Upload button), and the settings the files are built with. -->
  <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6">
    <Grid ColumnDefinitions="360,*,260" ColumnSpacing="14">
      <!-- The connected devices and their firmware -->
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="0,0,14,0">
          <TextBlock Text="{x:Static res:Strings.Devices_Connected}" FontWeight="SemiBold" IsVisible="{Binding HasDevices}" />
          <StackPanel Spacing="6" IsVisible="{Binding HasDevices}">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Devices_NoneFound}" IsVisible="{Binding !HasConnected}" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding SearchProblem}" IsVisible="{Binding HasSearchProblem}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <ListBox ItemsSource="{Binding Connected}" SelectedItem="{Binding SelectedConnected}" Background="Transparent" IsVisible="{Binding HasConnected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dv:ConnectedDeviceViewModel">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding SelectedConnected.FirmwareNote}" IsVisible="{Binding SelectedConnected.HasFirmwareNote}"
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <WrapPanel IsVisible="{Binding HasConnected}">
              <Button Content="{Binding SelectedConnected.FirmwareButtonText}" Command="{Binding UpdateFirmwareCommand}" Margin="0,0,6,6" />
              <Button Content="{x:Static res:Strings.Devices_FirmwareFile}" Command="{Binding UpdateFirmwareFromFileCommand}" Margin="0,0,6,6" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- What is sent to the selected device: the timelines and their order, what the build says, and the button that sends it -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto" IsVisible="{Binding HasPlan}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding SelectedPlan}" x:DataType="dv:UploadPlanViewModel" Spacing="6" Margin="0,0,14,0">
            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
            <StackPanel IsVisible="{Binding HasKindChoice}">
              <TextBlock Classes="muted" Text="{x:Static res:Strings.Devices_PlanKind}" />
              <ComboBox ItemsSource="{Binding KindTitles}" SelectedIndex="{Binding KindIndex}" MinWidth="240" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Devices_Timelines}" />
            <TextBlock Classes="muted" Text="{x:Static res:Strings.Devices_NoTimelines}" IsVisible="{Binding !Choices.Count}" />
            <ItemsControl ItemsSource="{Binding Choices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dv:UploadChoiceViewModel">
                  <DockPanel Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Order}" Width="22" VerticalAlignment="Center" Classes="muted" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                      <Button Content="↑" Command="{Binding $parent[ItemsControl].((dv:UploadPlanViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}" ToolTip.Tip="{x:Static res:Strings.Devices_Up}" Padding="8,2" />
                      <Button Content="↓" Command="{Binding $parent[ItemsControl].((dv:UploadPlanViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}" ToolTip.Tip="{x:Static res:Strings.Devices_Down}" Padding="8,2" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </CheckBox>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding IssueLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Classes="accent" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{x:Static res:Strings.Devices_Upload}" Command="{Binding UploadCommand}" />
      </Grid>
      <TextBlock Grid.Column="1" Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.Devices_NoShowHere}" IsVisible="{Binding HasNoShowDevice}" />

      <!-- The settings the files are built with -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="2" Margin="0,0,14,0">
          <TextBlock Text="{x:Static res:Strings.Devices_Settings}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.Devices_Depth}" />
          <ComboBox ItemsSource="{Binding Depths}" SelectedIndex="{Binding DepthIndex}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.Devices_GapStretching}" />
          <NumericUpDown Minimum="2" Maximum="13107" FormatString="0" Value="{Binding GapStretching}" />
          <TextBlock Classes="muted" Text="{x:Static res:Strings.Devices_LightRate}" />
          <NumericUpDown Minimum="1" Maximum="1000" FormatString="0" Value="{Binding LightRate}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- A transfer in progress (a show or firmware) and what became of it -->
    <DockPanel Grid.Row="1" IsVisible="{Binding IsUploading}">
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static res:Strings.Devices_Cancel}" Command="{Binding CancelUploadCommand}" IsVisible="{Binding CanCancel}" />
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" VerticalAlignment="Center" />
    </DockPanel>
    <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"
               IsVisible="{Binding HasMessage}" />
  </Grid>
</UserControl>
