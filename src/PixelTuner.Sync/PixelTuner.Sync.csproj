<Project Sdk="Microsoft.NET.Sdk">
  <!-- Device protocol: playback sync over UDP, device lookup, Art-Net.
       No UI and no platform APIs: used by desktop and mobile alike. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelTuner.Sync</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
