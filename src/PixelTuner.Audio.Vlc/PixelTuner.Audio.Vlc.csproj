<Project Sdk="Microsoft.NET.Sdk">
  <!-- The soundtrack player and the waveform reader on LibVLC, for Windows and macOS (and Linux, for
       development and CI). One engine for sound, waveform and, later, video. Phones use the system players. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelTuner.Audio.Vlc</RootNamespace>
    <!-- Only 64-bit Windows runs the app; skip the 32-bit LibVLC build the package would copy as well. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelTuner.Audio\PixelTuner.Audio.csproj" />
  </ItemGroup>
</Project>
