<Project Sdk="Microsoft.NET.Sdk">
  <!-- Show devices over USB (serial port) and Wi-Fi (TCP): identify, read their state, upload
       shows, firmware and settings. A port of PixelTuner 2's Communication/Service.
       Studio only: phones have no serial ports, and Stage does not upload. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelTuner.Devices</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>
  <ItemGroup>
    <!-- PixelTuner 2's Files/Flash_*.bin, byte for byte (FirmwareCatalogTests checks them against legacy/). -->
    <EmbeddedResource Include="Firmware\*.bin" LogicalName="PixelTuner.Devices.Firmware.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PixelTuner.Devices.Tests" />
  </ItemGroup>
</Project>
