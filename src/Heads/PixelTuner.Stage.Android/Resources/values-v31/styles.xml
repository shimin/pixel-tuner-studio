<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 12+ system splash screen. -->
  <style name="PtTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowBackground">@null</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/icon</item>
    <item name="postSplashScreenTheme">@style/PtTheme.Main</item>
  </style>
  <style name="PtTheme.Main" parent="PtTheme.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
  </style>
</resources>
