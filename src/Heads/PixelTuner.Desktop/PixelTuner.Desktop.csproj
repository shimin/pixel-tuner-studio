<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop head: Windows and macOS (Linux builds too, for CI). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelTuner.Desktop</RootNamespace>
    <AssemblyName>PixelTunerStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
    <!-- macOS bundle identity, used by the .app packaging script. -->
    <CFBundleName>Pixel Tuner Studio</CFBundleName>
    <CFBundleIdentifier>com.pixeltuner.studio</CFBundleIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PixelTuner.UI\PixelTuner.UI.csproj" />
  </ItemGroup>
</Project>
